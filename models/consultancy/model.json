// A small, made-up consultancy, to show a model that isn't climbing. Everything here is fictional.
{
  "name": "Example consultancy",
  "types": [
    {
      "name": "Person", "color": "#c2410c", "icon": "Person",
      // The name is made from the two name fields, so nobody types one. The fields show together under "Name".
      "nameTemplate": "{name_first} {name_last}",
      "source": { "file": "people.csv", "key": "id" },
      "fields": [
        { "key": "name_first", "group": "Name", "required": true, "description": "What they are called day to day." },
        { "key": "name_last", "group": "Name", "required": true },
        { "key": "title", "group": "Role", "description": "Their job title, not their grade." },
        { "key": "joined", "type": "date", "group": "Role", "description": "The day they started." },
        // Several values: split by | in the CSV, one per line on a form.
        { "key": "skills", "multiple": true, "description": "Things they could lead a workshop on." },
        { "key": "languages", "type": "choice", "options": [ "English", "French", "German", "Czech", "Japanese" ], "multiple": true, "description": "Languages they can work in." },
        { "key": "certified_on", "type": "date", "multiple": true, "description": "Each date they passed an accreditation." }
      ]
    },
    {
      "name": "Team", "color": "#4338ca", "icon": "Groups",
      "source": { "file": "teams.csv", "key": "id", "name": "name" },
      "fields": [ { "key": "floor", "type": "number", "description": "Which floor of the office the team sits on." } ]
    },
    {
      "name": "Client", "color": "#0f766e", "icon": "Business",
      "source": { "file": "clients.csv", "key": "id", "name": "name" },
      "fields": [ { "key": "sector" }, { "key": "city" } ]
    },
    {
      "name": "Project", "color": "#a16207", "icon": "Assignment",
      "source": { "file": "projects.csv", "key": "id", "name": "name" },
      "fields": [
        { "key": "started", "type": "date" },
        { "key": "budget", "type": "number", "description": "In pounds, before VAT." },
        { "key": "status", "type": "choice", "options": [ "proposed", "active", "live", "closed" ], "required": true, "description": "Where the project is now." }
      ]
    }
  ],
  "relationships": [
    // Everyone is in exactly one team: required, and at most one.
    { "from": "Person", "type": "MEMBER_OF", "to": "Team", "required": true, "max": 1, "source": { "file": "people.csv", "fromColumn": "id", "toColumn": "team" } },
    // A project is for at most one client.
    { "from": "Project", "type": "FOR", "to": "Client", "max": 1, "source": { "file": "projects.csv", "fromColumn": "id", "toColumn": "client" } },
    {
      "from": "Person", "type": "WORKS_ON", "to": "Project",
      "source": { "file": "assignments.csv", "fromColumn": "person", "toColumn": "project" },
      "fields": [
        { "key": "role", "description": "What they do on this project." },
        { "key": "days_a_week", "type": "number", "description": "Days a week they spend on it." }
      ]
    }
  ]
}
