// A small, made-up consultancy, to show a model that isn't climbing. Everything here is fictional.
{
  "name": "Example consultancy",
  "types": [
    {
      "name": "Person", "color": "#c2410c", "icon": "Person",
      // The name is made from the two name fields, so nobody types one. The fields show together under "Name".
      "nameTemplate": "{name_first} {name_last}",
      "source": { "file": "people.csv", "key": "id" },
      "fields": [
        { "key": "name_first", "group": "Name", "description": "What they are called day to day." },
        { "key": "name_last", "group": "Name", "description": "Leave empty for a single name." },
        { "key": "title", "group": "Role", "description": "Their job title, not their grade." },
        { "key": "joined", "type": "date", "group": "Role", "description": "The day they started." },
        // Several values: split by | in the CSV, one per line on a form.
        { "key": "skills", "multiple": true, "description": "Things they could lead a workshop on." },
        { "key": "working_language", "type": "choice", "options": [ "English", "French", "German", "Czech", "Japanese" ], "multiple": true, "description": "Languages they can work in." },
        { "key": "certified_on", "type": "date", "multiple": true, "description": "Each date they passed an accreditation." }
      ]
    },
    {
      "name": "Team", "color": "#4338ca", "icon": "Groups",
      "source": { "file": "teams.csv", "key": "id", "name": "name" },
      "fields": [ { "key": "floor", "type": "number", "description": "Which floor of the office the team sits on." } ]
    },
    {
      "name": "Client", "color": "#0f766e", "icon": "Business",
      "source": { "file": "clients.csv", "key": "id", "name": "name" },
      "fields": [ { "key": "sector" }, { "key": "city" } ]
    },
    {
      "name": "Project", "color": "#a16207", "icon": "Assignment",
      "source": { "file": "projects.csv", "key": "id", "name": "name", "label": { "level": "sensitivity", "anyOf": "practice", "allOf": "nda" } },
      // Each project says in its row who may see it. A blank cell takes this: internal, any practice, no NDA needed.
      "label": { "level": "internal" },
      "fields": [
        { "key": "started", "type": "date" },
        // Whoever may see a project may not see what it costs: a viewer below "confidential" sees this masked.
        { "key": "budget", "type": "number", "description": "In pounds, before VAT.", "label": { "level": "confidential" } },
        { "key": "status", "type": "choice", "options": [ "proposed", "active", "live", "closed" ], "required": true, "description": "Where the project is now." }
      ]
    }
  ],
  "relationships": [
    // Nobody is in two teams. (Add "required": true to make it exactly one, though then people can't be imported before their teams.)
    { "from": "Person", "type": "MEMBER_OF", "to": "Team", "max": 1, "source": { "file": "people.csv", "fromColumn": "id", "toColumn": "team" } },
    // A project is for at most one client.
    { "from": "Project", "type": "FOR", "to": "Client", "max": 1, "source": { "file": "projects.csv", "fromColumn": "id", "toColumn": "client" } },
    {
      "from": "Person", "type": "WORKS_ON", "to": "Project",
      "source": { "file": "assignments.csv", "fromColumn": "person", "toColumn": "project" },
      "fields": [
        { "key": "role", "description": "What they do on this project." },
        { "key": "days_a_week", "type": "number", "description": "Days a week they spend on it." }
      ]
    }
  ],
  // Who may see what, in this consultancy's own words. A part is used only if it's listed here, and its name is up to the model.
  // Project budgets and each client's work are commercially sensitive, so a project is labelled with the sensitivity it needs, the
  // practices that may see it (any one) and the clients whose NDAs cover it (all of them): see projects.csv. Labels are loaded
  // and can be changed in bulk, but nothing enforces them yet (docs/security-design.md). The users are made up.
  "security": {
    "level": { "name": "Sensitivity", "values": [ "public", "internal", "confidential" ] },
    "anyOf": { "name": "Practice", "values": [ "Design", "Engineering", "Delivery" ] },
    // Grants can come from a directory instead, for example:
    // "allOf": { "name": "NDA", "source": { "type": "api", "url": "https://directory.example/people/{user}", "path": "ndas", "cacheSeconds": 600, "tokenSetting": "Security:DirectoryToken" } }
    "allOf": { "name": "NDA", "values": [ "Harbourline", "Greenleaf", "Copperfield", "Northgate" ] },
    "users": {
      "sam.partner": { "level": "confidential", "anyOf": [ "Design", "Engineering", "Delivery" ], "allOf": [ "Harbourline", "Greenleaf", "Copperfield", "Northgate" ] },
      "ava.lindqvist": { "level": "internal", "anyOf": [ "Design" ], "allOf": [ "Harbourline" ] },
      "chloe.marsh": { "level": "internal", "anyOf": [ "Engineering" ], "allOf": [ "Harbourline", "Greenleaf" ] },
      "guest": { "level": "public" }
    }
  }
}
