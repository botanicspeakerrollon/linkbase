// A made-up retail group's enterprise architecture, in ArchiMate's three core layers (business, application, technology)
// and its strategy and motivation elements, as a large generic model: about 47,000 elements and 540,000 links across 25
// markets and 4 business lines each. The files are made by generate.py (see docs/models.md) from the hand-written core in
// core/. Everything here is fictional.
{
  "name": "Aldergate Retail Group (ArchiMate)",
  "types": [
    {
      "name": "BusinessActor", "color": "#ca8a04", "icon": "Person",
      "source": { "file": "actors.csv", "key": "id", "name": "name" },
      "fields": [
        { "key": "actor_type", "type": "choice", "options": [ "internal", "external" ], "description": "Staff or an outside party." },
        { "key": "department", "description": "The part of the business they belong to." }
      ]
    },
    {
      "name": "BusinessRole", "color": "#d97706", "icon": "Badge",
      "source": { "file": "roles.csv", "key": "id", "name": "name" },
      "fields": [ { "key": "description", "description": "What the role is responsible for." } ]
    },
    {
      "name": "BusinessProcess", "color": "#eab308", "icon": "Sync",
      "source": { "file": "processes.csv", "key": "id", "name": "name" },
