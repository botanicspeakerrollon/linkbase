@inject RecordRepository Records
@inject IDialogService Dialogs

@* Links a record to another, by one of the relationships its model allows. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudSelect T="LinkOption" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Relationship" Value="_option" ValueChanged="ChooseAsync"
                       ToStringFunc="Describe" Required="true" RequiredError="Choose a relationship">
                @foreach (var option in Options)
                {
                    <MudSelectItem Value="option">@Describe(option)</MudSelectItem>
                }
            </MudSelect>
            @if (_option is not null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Start">
                <MudAutocomplete @key="_option" T="RecordOption" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@_option.OtherType" @bind-Value="_other"
                                 SearchFunc="SearchAsync" ToStringFunc="@(o => o?.Name)" DebounceInterval="200" ResetValueOnEmptyText="true"
                                 Required="true" RequiredError="@($"Choose a {_option.OtherType}")">
                    <ItemTemplate Context="option">
                        @option.Name <MudText Typo="Typo.caption" Inline="true">@option.Key</MudText>
                    </ItemTemplate>
                </MudAutocomplete>
                <MudButton OnClick="CreateAsync" Variant="Variant.Text" Class="mt-2" StartIcon="@Icons.Material.Filled.Add">New @_option.OtherType</MudButton>
                </MudStack>
                <FieldInputs Fields="_attributes" Values="_values" />
            }
        </MudForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Instance.Cancel())">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">Link</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int Suggestions = 20;

    [CascadingParameter] private IMudDialogInstance Instance { get; set; } = null!;
    [Parameter] public RecordDetail Record { get; set; } = null!;
    [Parameter] public IReadOnlyList<LinkOption> Options { get; set; } = [];

    private MudForm? _form;
    private LinkOption? _option;
    private RecordOption? _other;
    private string? _error;

    // What the chosen relationship's links carry, such as a role, and what's been typed for it.
    private IReadOnlyList<RecordField> _attributes = [];
    private Dictionary<string, string?> _values = [];

    protected override async Task OnInitializedAsync()
    {
        if (Options.Count == 1)
        {
            await ChooseAsync(Options[0]);
        }
    }

    private async Task ChooseAsync(LinkOption? option)
    {
        _option = option;
        _attributes = option is null
            ? []
            : option.Outgoing
                ? await Records.LinkAttributesAsync(Record.Type, option.RelType, option.OtherType)
                : await Records.LinkAttributesAsync(option.OtherType, option.RelType, Record.Type);
        _values = _attributes.ToDictionary(a => a.Key, _ => (string?)null);
    }

    private string Describe(LinkOption? option) => option is null
        ? ""
        : option.Outgoing ? $"{Record.Type} {option.RelType} {option.OtherType}" : $"{option.OtherType} {option.RelType} {Record.Type}";

    private async Task<IEnumerable<RecordOption>> SearchAsync(string text, CancellationToken cancellationToken) =>
        await Records.FindAsync(_option!.OtherType, text, Suggestions, cancellationToken);

    // Creates a record of the other type, here and now, and chooses it.
    private async Task CreateAsync()
    {
        var type = await Records.TypeAsync(_option!.OtherType);
        if (type is null)
        {
            return;
        }

        var parameters = new DialogParameters<RecordDialog> { { d => d.Type, type } };
        var dialog = await Dialogs.ShowAsync<RecordDialog>($"New {type.Name}", parameters);
        if (await dialog.Result is { Canceled: false, Data: string key })
        {
            _other = (await Records.FindAsync(type.Name, key, 1)).FirstOrDefault(o => o.Key == key);
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _option is null || _other is null)
        {
            return;
        }

        try
        {
            if (_option.Outgoing)
            {
                await Records.AddLinkAsync(Record.Id, _option.RelType, _other.Id, _values);
            }
            else
            {
                await Records.AddLinkAsync(_other.Id, _option.RelType, Record.Id, _values);
            }

            Instance.Close(DialogResult.Ok(true));
        }
        catch (LinkbaseValidationException ex)
        {
            _error = ex.Message;
        }
    }
}
