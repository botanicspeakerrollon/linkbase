@using System.Globalization
@inject HistoryRepository History
@inject ChangeReverter Reverter
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* One record's audit trail, newest first: what changed, when, and why. Only shown where the model keeps a history. *@
@if (_entries.Count > 0)
{
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">History</MudText>
    <MudList T="string" Dense="true" Class="record-history">
        @foreach (var entry in _entries)
        {
            <MudListItem T="string">
                <div>
                    <div class="d-flex align-center" style="gap: 8px">
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@entry.When.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)</MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@KindName(entry.Kind)</MudChip>
                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                        {
                            <span class="history-note">@entry.Note</span>
                        }
                        @if (entry.SourceId is { } source)
                        {
                            <span class="history-source">
                                @if (entry.SourceKind is { } sourceKind)
                                {
                                    <span>@sourceKind: </span>
                                }
                                @if (Uri.TryCreate(source, UriKind.Absolute, out var url) && url.Scheme is "http" or "https")
                                {
                                    <MudLink Href="@source" Target="_blank" rel="noopener noreferrer">@source</MudLink>
                                }
                                else
                                {
                                    <span>@source</span>
                                }
                            </span>
                        }
                        else if (entry.SourceKind is { } kindOnly)
                        {
                            <span class="history-source">@kindOnly</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.SourceComment))
                        {
                            <span class="history-note">(@entry.SourceComment)</span>
                        }
                        @if (entry.ChangeSetId != 0 && entry.Kind == JustificationKind.Manual)
                        {
                            <MudButton OnClick="@(() => RevertAsync(entry))" Variant="Variant.Text" Size="Size.Small" Disabled="_busy">Revert</MudButton>
                        }
                    </div>
                    @foreach (var change in entry.Changes)
                    {
                        <div class="history-change">@Describe(change)</div>
                    }
                </div>
            </MudListItem>
        }
    </MudList>
    @if (_more)
    {
        <MudButton OnClick="MoreAsync" Variant="Variant.Text" Size="Size.Small">Show older</MudButton>
    }
}

@code {
    [Parameter, EditorRequired] public string RecordId { get; set; } = "";

    // Changes after this component first showed, such as an edit, are picked up by loading again.
    [Parameter] public int Version { get; set; }

    // Called once an edit has been reverted, so the page can show the record as it is now.
    [Parameter] public EventCallback OnReverted { get; set; }

    private bool _busy;

    private List<HistoryEntry> _entries = [];
    private bool _more;
    private string? _loaded;

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{RecordId}/{Version}";
        if (_loaded == key)
        {
            return;
        }

        _loaded = key;
        var page = await History.ForRecordAsync(RecordId);
        _entries = page.ToList();
        _more = page.Count >= HistoryRepository.PageSize;
    }

    private async Task MoreAsync()
    {
        var page = await History.ForRecordAsync(RecordId, _entries.Where(e => e.ChangeSetId != 0).Select(e => e.When).Min());
        _entries.AddRange(page);
        _more = page.Count >= HistoryRepository.PageSize;
    }

    // Puts back what one edit changed, if nothing has changed it since. The revert is an edit of its own, in the history.
    private async Task RevertAsync(HistoryEntry entry)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Revert this change?",
            "The values it changed go back to what they were, as a new edit in the history. If any of them has been changed again since, nothing is reverted.",
            yesText: "Revert", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var notes = await Reverter.RevertAsync(entry.ChangeSetId);
            Snackbar.Add(notes.Count == 0 ? "Change reverted." : $"Change reverted. {string.Join(" ", notes)}", Severity.Success);
            await OnReverted.InvokeAsync();
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string KindName(JustificationKind kind) => kind switch
    {
        JustificationKind.Import => "Import",
        JustificationKind.Derived => "Derived",
        JustificationKind.Correction => "Correction",
        _ => "Edit",
    };

    private string Describe(HistoryChange change)
    {
        var mine = change.EntityId == RecordId;
        switch (change.Kind)
        {
            case ChangeEntityKind.Node:
                return change.Op switch
                {
                    ChangeOp.Create => "Created.",
                    ChangeOp.Delete => "Deleted.",
                    _ => $"{RecordRepository.Title(change.FieldKey ?? "name")}: {Show(change.OldValue)} → {Show(change.NewValue)}",
                };
            case ChangeEntityKind.Link:
                var link = mine ? $"{change.RelType} → {change.OtherName}" : $"{change.OtherName} {change.RelType} →";
                return change.Op switch
                {
                    ChangeOp.Create => $"Linked: {link}",
                    ChangeOp.Delete => $"Unlinked: {link}",
                    _ => $"{link}, {RecordRepository.Title(change.FieldKey ?? "")}: {Show(change.OldValue)} → {Show(change.NewValue)}",
                };
            case ChangeEntityKind.Label:
                var labelled = change.RelType is null ? "" : (mine ? $"{change.RelType} → {change.OtherName}" : $"{change.OtherName} {change.RelType} →") + ", ";
                return $"{labelled}{change.FieldKey}: {Show(change.OldValue)} → {Show(change.NewValue)}";
            case ChangeEntityKind.ExternalRef:
                return $"Removed the {change.FieldKey} id {change.OldValue}.";
            default:
                return "";
        }
    }

    private static string Show(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return "(empty)";
        }

        var line = value.Replace('\n', ',').Trim();
        return line.Length > 80 ? line[..80] + "…" : line;
    }
}
