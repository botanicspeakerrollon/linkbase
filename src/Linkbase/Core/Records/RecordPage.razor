@page "/data/{Type}/{*Key}"
@inject RecordRepository Records
@inject ExternalRefRepository Refs
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LabelRepository Labels

@* One record, its values and its links, generated from the model's definition. *@
<PageTitle>@(_record?.Name ?? Type)</PageTitle>

@if (_missing)
{
    <MudAlert Severity="Severity.Warning">There's no @Type with the key @Key.</MudAlert>
}
else if (_record is not null && _type is not null)
{
    <MudBreadcrumbs Items="_crumbs" Class="pa-0 mb-2" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@_style!.Icon" Style="@($"color: {_style.Color}")" />
            <MudText Typo="Typo.h4" HtmlTag="h1">@_record.Name</MudText>
        </MudStack>
        @if (_type.Owner is null)
        {
            <MudStack Row="true">
                @if (_security is not null)
                {
                    <MudButton OnClick="LabelAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Lock"
                               title="Set who can see this record">Label…</MudButton>
                }
                <MudButton OnClick="EditAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
                <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error">Delete</MudButton>
            </MudStack>
        }
    </MudStack>

    @if (_type.Owner is not null)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@RecordListPage.DerivedNote(_type)</MudAlert>
    }

    @if (_security is not null && _label is not null)
    {
        <MudText Typo="Typo.body2" Class="mb-2 record-label">@LabelText()</MudText>
    }

    <MudSimpleTable Dense="true" Elevation="1" Class="mb-6 record-values">
        <tbody>
            <tr><th scope="row">Key</th><td>@_record.Key</td></tr>
            @foreach (var section in FieldSection.Of(_type.Fields))
            {
                @if (section.Group is not null)
                {
                    <tr><th scope="colgroup" colspan="2" class="group-heading">@section.Group</th></tr>
                }

                @foreach (var field in section.Fields)
                {
                <tr>
                    <th scope="row" class="@(section.Group is null ? "" : "in-group")">
                        @RecordRepository.Title(field.Key)
                        @if (field.Description is not null)
                        {
                            <MudText Typo="Typo.caption" Class="d-block" Style="color: var(--mud-palette-text-secondary); font-weight: normal">@field.Description</MudText>
                        }
                    </th>
                    <td>
                        @(_record.Masked.Contains(field.Key) ? RecordListPage.MaskText : RecordListPage.Shown(field, _record.Values.GetValueOrDefault(field.Key)))
                        @if (field.Owner is not null && _type.Owner is null)
                        {
                            <MudText Typo="Typo.caption" Inline="true" Class="ml-2" Style="color: var(--mud-palette-text-secondary)">kept by @field.Owner</MudText>
                        }
                    </td>
                </tr>
                }
            }
            @foreach (var (key, value) in _record.Values.Where(v => _type.Fields.All(f => f.Key != v.Key)).OrderBy(v => v.Key))
            {
                <tr><th scope="row">@RecordRepository.Title(key)</th><td>@value</td></tr>
            }
            @foreach (var reference in _refs)
            {
                <tr>
                    <th scope="row">@ExternalRefRepository.SourceName(reference.Source) id</th>
                    <td>
                        @if (Uri.TryCreate(reference.Url, UriKind.Absolute, out var url) && url.Scheme is "http" or "https")
                        {
                            <MudLink Href="@reference.Url" Target="_blank" rel="noopener noreferrer">@reference.ExternalId</MudLink>
                        }
                        else
                        {
                            @reference.ExternalId
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h6" HtmlTag="h2">Links</MudText>
        @if (_options.Count > 0 && _type.Owner is null)
        {
            <MudButton OnClick="LinkAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AddLink" Size="Size.Small">Add link</MudButton>
        }
    </MudStack>

    @if (_links.Count == 0)
    {
        <MudText Typo="Typo.body2">No links yet.</MudText>
    }

    @foreach (var group in _links)
    {
        <MudText Typo="Typo.subtitle2" HtmlTag="h3" Class="mt-4 mb-1">
            @(group.Outgoing ? $"{group.RelType} →" : $"← {group.RelType}")
            <span class="record-count">@group.Total.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</span>
        </MudText>
        <MudList T="string" Dense="true" Class="record-links">
            @foreach (var link in group.Links)
            {
                <MudListItem T="string">
                    <div class="d-flex align-center" style="gap: 8px">
                        <MudLink Href="@GraphStyle.RecordLink(link.OtherType, link.OtherKey)">@link.OtherName</MudLink>
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">@link.OtherType · @link.OtherKey</MudText>
                        @{ var attributes = AttributesOf(group, link); }
                        @foreach (var attribute in attributes.Where(a => link.Values.ContainsKey(a.Key)))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @RecordRepository.Title(attribute.Key): @RecordListPage.Shown(attribute, link.Values[attribute.Key])
                            </MudChip>
                        }
                        @if (_type.Owner is null && !_derived.Contains(link.OtherType))
                        {
                            @if (attributes.Count > 0)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="ml-auto"
                                               aria-label="@($"Edit the link to {link.OtherName}")" OnClick="@(() => EditLinkAsync(link, attributes))" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small" Class="@(attributes.Count > 0 ? "" : "ml-auto")"
                                           aria-label="@($"Remove the link to {link.OtherName}")" OnClick="@(() => UnlinkAsync(link))" />
                        }
                    </div>
                </MudListItem>
            }
        </MudList>
        @if (group.Total > group.Links.Count)
        {
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                The first @group.Links.Count of @group.Total.ToString("N0", System.Globalization.CultureInfo.InvariantCulture). Explore shows the rest.
            </MudText>
        }
    }

    <RecordHistory RecordId="@_record.Id" Version="_version" OnReverted="LoadAsync" />
}

@code {
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";

    private RecordType? _type;
    private RecordDetail? _record;
    private LabelStyle? _style;
    private IReadOnlyList<RecordLinkGroup> _links = [];
    private IReadOnlyList<NodeRef> _refs = [];
    private IReadOnlyList<LinkOption> _options = [];
    private List<BreadcrumbItem> _crumbs = [];
    private bool _missing;
    private int _version;

    // Loaded with the page, so opening a dialog has nothing to wait for.
    private HistorySettings _history = HistorySettings.Default;

    // Types a module derives. Links to them are its own, so they can't be removed here.
    private HashSet<string> _derived = [];

    // Set only when the model uses security. The record's label, in the model's own names.
    private ModelSecurity? _security;
    private LabelValue? _label;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private string LabelText()
    {
        var parts = new List<string>();
        if (_security!.Level is { } level)
        {
            parts.Add($"{level.Name}: {_label!.Level ?? "none"}");
        }

        if (_security.AnyOf is { } any)
        {
            parts.Add($"{any.Name}: {(_label!.AnyOf.Count == 0 ? "everyone" : string.Join(", ", _label.AnyOf))}");
        }

        if (_security.AllOf is { } all)
        {
            parts.Add($"{all.Name}: {(_label!.AllOf.Count == 0 ? "none needed" : string.Join(", ", _label.AllOf))}");
        }

        return string.Join(" · ", parts);
    }

    private async Task LabelAsync()
    {
        var parameters = new DialogParameters<LabelDialog>
        {
            { d => d.NodeIds, new[] { _record!.Id } }, { d => d.Security, _security }, { d => d.Current, _label }, { d => d.History, _history },
        };
        var dialog = await Dialogs.ShowAsync<LabelDialog>($"Label {_record.Name}", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            _label = await Labels.GetNodeAsync(_record.Id);
        }
    }

    private async Task LoadAsync()
    {
        var types = await Records.TypesAsync();
        _derived = types.Where(t => t.Owner is not null).Select(t => t.Name).ToHashSet();
        _type = types.FirstOrDefault(t => t.Name == Type);
        _history = await Records.HistorySettingsAsync();
        _record = _type is null ? null : await Records.GetAsync(Type, Key);
        _missing = _record is null;
        if (_record is null)
        {
            return;
        }

        _style = GraphStyle.For(Type, _type!.Color, _type.Icon);
        _security = await Labels.SettingsAsync() is { Enabled: true } enabled ? enabled : null;
        _label = _security is null ? null : await Labels.GetNodeAsync(_record.Id);
        _refs = await Refs.RefsAsync(_record.Id);
        _options = await Records.LinkOptionsAsync(Type);
        _crumbs = [new BreadcrumbItem(Type, GraphStyle.RecordListLink(Type))];
        await LoadLinksAsync();
    }

    // The links, and what each kind of link can carry, such as a role.
    private async Task LoadLinksAsync()
    {
        _version++;
        _links = await Records.LinksAsync(_record!.Id);
        _attributes = [];
        foreach (var group in _links)
        {
            foreach (var otherType in group.Links.Select(l => l.OtherType).Distinct().Where(t => !_attributes.ContainsKey((group.RelType, group.Outgoing, t))))
            {
                _attributes[(group.RelType, group.Outgoing, otherType)] = group.Outgoing
                    ? await Records.LinkAttributesAsync(Type, group.RelType, otherType)
                    : await Records.LinkAttributesAsync(otherType, group.RelType, Type);
            }
        }
    }

    private Dictionary<(string RelType, bool Outgoing, string OtherType), IReadOnlyList<RecordField>> _attributes = [];

    private IReadOnlyList<RecordField> AttributesOf(RecordLinkGroup group, RecordLink link) =>
        _attributes.GetValueOrDefault((group.RelType, group.Outgoing, link.OtherType)) ?? [];

    private async Task EditLinkAsync(RecordLink link, IReadOnlyList<RecordField> attributes)
    {
        var parameters = new DialogParameters<LinkValuesDialog>
        {
            { d => d.LinkId, link.Id }, { d => d.Attributes, attributes }, { d => d.Current, link.Values },
            { d => d.History, _history },
        };
        var dialog = await Dialogs.ShowAsync<LinkValuesDialog>($"Edit the link to {link.OtherName}", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Saved.", Severity.Success);
            await LoadLinksAsync();
        }
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<RecordDialog> { { d => d.Type, _type }, { d => d.Record, _record }, { d => d.History, _history } };
        var dialog = await Dialogs.ShowAsync<RecordDialog>($"Edit {_record!.Name}", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Saved.", Severity.Success);
            await LoadAsync();
        }
    }

    // Where the model keeps a history, the confirmation also asks why. Confirmed is false if it was cancelled.
    private async Task<(bool Confirmed, ChangeReason? Reason)> ConfirmAsync(string title, string message, string confirmText)
    {
        var settings = _history;
        if (!settings.Record)
        {
            return (await Dialogs.ShowMessageBoxAsync(title, message, yesText: confirmText, cancelText: "Cancel") == true, null);
        }

        var parameters = new DialogParameters<ReasonDialog> { { d => d.Message, message }, { d => d.ConfirmText, confirmText }, { d => d.Settings, settings } };
        var dialog = await Dialogs.ShowAsync<ReasonDialog>(title, parameters);
        return await dialog.Result is { Canceled: false, Data: ReasonDraft draft } ? (true, draft.ToReason()) : (false, null);
    }

    private async Task DeleteAsync()
    {
        var (confirmed, reason) = await ConfirmAsync($"Delete {_record!.Name}?", "This can't be undone.", "Delete");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await Records.DeleteAsync(_record.Id, reason);
            Snackbar.Add($"{_record.Name} deleted.", Severity.Success);
            Navigation.NavigateTo(GraphStyle.RecordListLink(Type));
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task LinkAsync()
    {
        var parameters = new DialogParameters<LinkDialog> { { d => d.Record, _record }, { d => d.Options, _options }, { d => d.History, _history } };
        var dialog = await Dialogs.ShowAsync<LinkDialog>("Add link", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Linked.", Severity.Success);
            await LoadLinksAsync();
        }
    }

    private async Task UnlinkAsync(RecordLink link)
    {
        ChangeReason? reason = null;
        if (_history.Record)
        {
            var (confirmed, given) = await ConfirmAsync($"Remove the link to {link.OtherName}?", "The link goes. The history keeps a note of it.", "Remove");
            if (!confirmed)
            {
                return;
            }

            reason = given;
        }

        try
        {
            await Records.RemoveLinkAsync(link.Id, reason);
            Snackbar.Add($"Removed the link to {link.OtherName}.", Severity.Success);
            await LoadLinksAsync();
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
