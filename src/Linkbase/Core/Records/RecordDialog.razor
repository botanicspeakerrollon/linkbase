@using System.Globalization
@inject RecordRepository Records
@inject IDialogService Dialogs

@* Adds or edits a record, with a box for each of its type's fields. A new record also chooses the links its type requires, from
   the records there are or by creating one, which can need records of its own. A dialog in Collect mode saves nothing: it
   hands back what to create, and the dialog that asked saves everything together. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_name" Label="Name" Required="true" RequiredError="A record needs a name" />
            @if (Record is null)
            {
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_key" Label="Key"
                              HelperText="What identifies it, and can't change later. Made from the name if left empty." />
            }

            @foreach (var field in Type.Editable)
            {
                var key = field.Key;
                var label = RecordRepository.Title(key);
                var required = field.Required;
                var requiredError = $"{label} is required";
                @switch (field.Type)
                {
                    case FieldType.Date:
                        <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Date="@DateOf(key)" DateChanged="@(d => SetDate(key, d))"
                                       Clearable="true" DateFormat="yyyy-MM-dd" />
                        break;
                    case FieldType.Boolean:
                        <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Value="@(_values.GetValueOrDefault(key) ?? "")"
                                   ValueChanged="@(v => _values[key] = v)" ToStringFunc="@YesNo">
                            <MudSelectItem Value="@("")" />
                            <MudSelectItem Value="@("true")" />
                            <MudSelectItem Value="@("false")" />
                        </MudSelect>
                        break;
                    case FieldType.Choice:
                        <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Value="@(_values.GetValueOrDefault(key) ?? "")"
                                   ValueChanged="@(v => _values[key] = v)" ToStringFunc="@(v => v ?? "")" Clearable="true">
                            @foreach (var option in field.Options)
                            {
                                <MudSelectItem Value="@option">@option</MudSelectItem>
                            }
                        </MudSelect>
                        break;
                    case FieldType.List:
                        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Value="@_values.GetValueOrDefault(key)"
                                      ValueChanged="@(v => _values[key] = v)" Lines="2" AutoGrow="true" HelperText="One per line" />
                        break;
                    case FieldType.Number:
                        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Value="@_values.GetValueOrDefault(key)"
                                      ValueChanged="@(v => _values[key] = v)" InputMode="@(InputMode.@decimal)" />
                        break;
                    default:
                        <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@label" Required="@required" RequiredError="@requiredError" Value="@_values.GetValueOrDefault(key)"
                                      ValueChanged="@(v => _values[key] = v)" />
                        break;
                }
            }

            @if (Record is null)
            {
                @foreach (var link in Type.RequiredLinks)
                {
                    var needed = link;
                    @if (_creates.TryGetValue(needed, out var pending))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" OnClose="@(() => _creates.Remove(needed))">New @needed.OtherType: @pending.Input.Name</MudChip>
                            <MudText Typo="Typo.caption">@Type.Name @needed.RelType @needed.OtherType</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Start">
                            <MudAutocomplete T="RecordOption" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@needed.OtherType"
                                             HelperText="@($"{Type.Name} {needed.RelType} {needed.OtherType}")"
                                             Value="@_links.GetValueOrDefault(needed)" ValueChanged="@(o => _links[needed] = o)"
                                             SearchFunc="@((text, token) => SearchAsync(needed, text, token))" ToStringFunc="@(o => o?.Name)"
                                             DebounceInterval="200" ResetValueOnEmptyText="true" Required="true" RequiredError="@($"Choose its {needed.OtherType}")">
                                <ItemTemplate Context="option">
                                    @option.Name <MudText Typo="Typo.caption" Inline="true">@option.Key</MudText>
                                </ItemTemplate>
                            </MudAutocomplete>
                            <MudButton OnClick="@(() => CreateAsync(needed))" Variant="Variant.Text" Class="mt-2" StartIcon="@Icons.Material.Filled.Add">New @needed.OtherType</MudButton>
                        </MudStack>
                    }
                }
            }
        </MudForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Instance.Cancel())">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Instance { get; set; } = null!;
    [Parameter] public RecordType Type { get; set; } = null!;

    // Null to add a new record.
    [Parameter] public RecordDetail? Record { get; set; }

    // Hand back the record to create instead of saving it, for a dialog that is creating a record for another to link to.
    [Parameter] public bool Collect { get; set; }

    private MudForm? _form;
    private string? _name;
    private string? _key;
    private Dictionary<string, string?> _values = [];
    private string? _error;

    // The record chosen for each link the type requires.
    private readonly Dictionary<RequiredLink, RecordOption?> _links = [];

    // The record to create for each link the type requires, instead of choosing one that is there.
    private readonly Dictionary<RequiredLink, PendingRecord> _creates = [];
    private const int Suggestions = 20;

    protected override void OnInitialized()
    {
        _name = Record?.Name;
        _values = Type.Editable.ToDictionary(f => f.Key, f => Record?.Values.GetValueOrDefault(f.Key));
    }

    private DateTime? DateOf(string key) =>
        DateTime.TryParseExact(_values.GetValueOrDefault(key), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? date : null;

    private void SetDate(string key, DateTime? date) => _values[key] = date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private static string YesNo(string? value) => value switch { "true" => "Yes", "false" => "No", _ => "" };

    private async Task<IEnumerable<RecordOption>> SearchAsync(RequiredLink link, string text, CancellationToken cancellationToken) =>
        await Records.FindAsync(link.OtherType, text, Suggestions, cancellationToken);

    private async Task CreateAsync(RequiredLink link)
    {
        var other = await Records.TypeAsync(link.OtherType);
        if (other is null)
        {
            _error = $"There's no type called {link.OtherType}.";
            return;
        }

        var parameters = new DialogParameters<RecordDialog> { { d => d.Type, other }, { d => d.Collect, true } };
        var dialog = await Dialogs.ShowAsync<RecordDialog>($"New {link.OtherType}", parameters);
        if (await dialog.Result is { Canceled: false, Data: PendingRecord pending })
        {
            _creates[link] = pending;
            _links.Remove(link);
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        try
        {
            var input = new RecordInput(_name!, _values)
            {
                Links = _links.Where(l => l.Value is not null).Select(l => new NewLink(l.Key.RelType, l.Value!.Id)).ToList(),
                Creates = _creates.Select(c => new NewLinkedRecord(c.Key.RelType, c.Key.OtherType, c.Value.Key, c.Value.Input)).ToList(),
            };
            if (Collect)
            {
                Instance.Close(DialogResult.Ok(new PendingRecord(Type.Name, string.IsNullOrWhiteSpace(_key) ? null : _key, input)));
                return;
            }

            var key = Record is null ? await Records.CreateAsync(Type.Name, _key, input) : Record.Key;
            if (Record is not null)
            {
                await Records.UpdateAsync(Record.Id, input);
            }

            Instance.Close(DialogResult.Ok(key));
        }
        catch (LinkbaseValidationException ex)
        {
            _error = ex.Message;
        }
    }
}

