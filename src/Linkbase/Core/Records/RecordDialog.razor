@using Linkbase.Core.Models
@using System.Globalization
@inject IRecordRepository Records
@inject IDialogService Dialogs

@* Adds or edits a record, with a box for each of its type's fields. A new record also chooses the links its type requires, from
   the records there are or by creating one, which can need records of its own. A dialog in Collect mode saves nothing: it
   hands back what to create, and the dialog that asked saves everything together. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (Type.NameTemplate is null)
            {
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_name" Label="Name" Required="true" RequiredError="A record needs a name" />
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-2 d-block">Its name is made from @string.Join(", ", NameTemplates.Tokens(Type.NameTemplate).Distinct().Select(RecordRepository.Title)).</MudText>
            }

            @if (Record is null)
            {
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_key" Label="Key"
                              HelperText="What identifies it, and can't change later. Made from the name if left empty." />
            }

            <FieldInputs Fields="Type.Editable.Where(f => Record?.Masked.Contains(f.Key) != true)" Values="_values" />

            @if (Record is null)
            {
                @foreach (var link in Links)
                {
                    var needed = link;
                    @if (_creates.TryGetValue(needed, out var pending))
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" OnClose="@(() => _creates.Remove(needed))">New @needed.OtherType: @pending.Input.Name</MudChip>
                            <MudText Typo="Typo.caption">@Type.Name @needed.RelType @needed.OtherType</MudText>
                        </MudStack>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Start">
                            <MudAutocomplete T="RecordOption" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@(IsParent(needed) ? "Parent" : needed.OtherType)"
                                             HelperText="@(IsParent(needed) ? $"The {Type.Name} it is {needed.RelType}. Needed below the top level, and left empty at the top." : $"{Type.Name} {needed.RelType} {needed.OtherType}")"
                                             Value="@_links.GetValueOrDefault(needed)" ValueChanged="@(o => _links[needed] = o)"
                                             SearchFunc="@((text, token) => SearchAsync(needed, text, token))" ToStringFunc="@(o => o?.Name)"
                                             DebounceInterval="200" ResetValueOnEmptyText="true" Required="@(!IsParent(needed))" RequiredError="@($"Choose its {needed.OtherType}")">
                                <ItemTemplate Context="option">
                                    @option.Name <MudText Typo="Typo.caption" Inline="true">@option.Key</MudText>
                                </ItemTemplate>
                            </MudAutocomplete>
                            <MudButton OnClick="@(() => CreateAsync(needed))" Variant="Variant.Text" Class="mt-2" StartIcon="@Icons.Material.Filled.Add">New @needed.OtherType</MudButton>
                        </MudStack>
                    }
                    @if (_attributes.TryGetValue(needed, out var attributes) && attributes.Count > 0)
                    {
                        <FieldInputs Fields="attributes" Values="_linkValues[needed]" />
                    }
                }
            }

            @* A record made for another dialog to link to is saved, with its reason, by that dialog. *@
            @if (!Collect)
            {
                <ReasonInput Draft="_reason" Settings="_history" OnSubmit="SaveAsync" />
            }
        </MudForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Instance.Cancel())">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Instance { get; set; } = null!;
    [Parameter] public RecordType Type { get; set; } = null!;

    // Null to add a new record.
    [Parameter] public RecordDetail? Record { get; set; }

    // Hand back the record to create instead of saving it, for a dialog that is creating a record for another to link to.
    [Parameter] public bool Collect { get; set; }

    // The model's history settings. The page that opens the dialog passes them, so the dialog has nothing to wait for; it looks
    // them up itself if they aren't given.
    [Parameter] public HistorySettings? History { get; set; }

    private MudForm? _form;
    private string? _name;
    private string? _key;
    private Dictionary<string, string?> _values = [];
    private string? _error;
    private readonly ReasonDraft _reason = new();
    private HistorySettings _history = HistorySettings.Default;

    // The record chosen for each link the type requires.
    private readonly Dictionary<RequiredLink, RecordOption?> _links = [];

    // The record to create for each link the type requires, instead of choosing one that is there.
    private readonly Dictionary<RequiredLink, PendingRecord> _creates = [];
    private const int Suggestions = 20;

    // What each required link can carry, such as a role, and what's been typed for it.
    private readonly Dictionary<RequiredLink, IReadOnlyList<RecordField>> _attributes = [];
    private readonly Dictionary<RequiredLink, Dictionary<string, string?>> _linkValues = [];

    protected override void OnInitialized()
    {
        _name = Record?.Name;
        _values = Type.Editable.ToDictionary(f => f.Key, f => Record?.Values.GetValueOrDefault(f.Key));
        _history = History ?? HistorySettings.Default;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Collect && History is null)
        {
            _history = await Records.HistorySettingsAsync();
        }

        if (Record is null)
        {
            foreach (var link in Links)
            {
                var attributes = await Records.LinkAttributesAsync(Type.Name, link.RelType, link.OtherType);
                _attributes[link] = attributes;
                _linkValues[link] = attributes.ToDictionary(a => a.Key, _ => (string?)null);
            }
        }
    }

    // The links a new record asks for: the ones its type requires, and its parent if the type is a hierarchy. The parent is
    // optional here, since whether one is needed depends on the level chosen, which the repository checks.
    private IEnumerable<RequiredLink> Links =>
        Type.Hierarchy is { } hierarchy ? Type.RequiredLinks.Append(new RequiredLink(hierarchy.RelType, Type.Name)) : Type.RequiredLinks;

    private bool IsParent(RequiredLink link) => Type.Hierarchy is { } hierarchy && link == new RequiredLink(hierarchy.RelType, Type.Name);

    private async Task<IEnumerable<RecordOption>> SearchAsync(RequiredLink link, string text, CancellationToken cancellationToken) =>
        await Records.FindAsync(link.OtherType, text, Suggestions, cancellationToken);

    private async Task CreateAsync(RequiredLink link)
    {
        var other = await Records.TypeAsync(link.OtherType);
        if (other is null)
        {
            _error = $"There's no type called {link.OtherType}.";
            return;
        }

        var parameters = new DialogParameters<RecordDialog> { { d => d.Type, other }, { d => d.Collect, true } };
        var dialog = await Dialogs.ShowAsync<RecordDialog>($"New {link.OtherType}", parameters);
        if (await dialog.Result is { Canceled: false, Data: PendingRecord pending })
        {
            _creates[link] = pending;
            _links.Remove(link);
        }
    }

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        try
        {
            var input = new RecordInput(Type.NameTemplate is { } template ? NameTemplates.Render(template, _values) ?? "" : _name!, _values)
            {
                Links = _links.Where(l => l.Value is not null).Select(l => new NewLink(l.Key.RelType, l.Value!.Id, _linkValues[l.Key])).ToList(),
                Creates = _creates.Select(c => new NewLinkedRecord(c.Key.RelType, c.Key.OtherType, c.Value.Key, c.Value.Input, _linkValues[c.Key])).ToList(),
            };
            if (Collect)
            {
                Instance.Close(DialogResult.Ok(new PendingRecord(Type.Name, string.IsNullOrWhiteSpace(_key) ? null : _key, input)));
                return;
            }

            var key = Record is null ? await Records.CreateAsync(Type.Name, _key, input, _reason.ToReason()) : Record.Key;
            if (Record is not null)
            {
                await Records.UpdateAsync(Record.Id, input, _reason.ToReason());
            }

            Instance.Close(DialogResult.Ok(key));
        }
        catch (LinkbaseValidationException ex)
        {
            _error = ex.Message;
        }
    }
}

