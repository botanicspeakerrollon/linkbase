@page "/import/review/{BatchId:long}"
@page "/import-csv/review/{BatchId:long}"
@using System.Globalization
@inject ImportStagingService Staging
@inject RecordRepository Records
@using Linkbase.Core.Explore
@using Linkbase.Core.Records
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* What a staged import would add, to look through before anything changes. Items can be left out, then the rest are
   committed in one go, or the whole import is discarded. *@
<PageTitle>Review an import</PageTitle>

@if (_missing)
{
    <MudAlert Severity="Severity.Warning">There's no such import.</MudAlert>
    <MudButton Href="/import-csv" Variant="Variant.Text" Class="mt-2">Back to imports</MudButton>
}
else if (_batch is not null)
{
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">Review @_batch.File</MudText>
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary)">
        @Count(_batch.Items) @_batch.What staged, @Count(_batch.Included) included.
        @if (_batch.Updating > 0)
        {
            <span> @Count(_batch.Updating) of them update records already here.</span>
        }
        @if (_batch.AlreadyThere > 0)
        {
            <span> @Count(_batch.AlreadyThere) already here, left as they are.</span>
        }
        @if (_batch.Skipped > 0)
        {
            <span> @Count(_batch.Skipped) skipped.</span>
        }
    </MudText>
    @foreach (var note in _batch.Notes)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-1">@note</MudAlert>
    }

    @if (_batch.Status != ImportStatus.Staged)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">
            This import has been @(_batch.Status == ImportStatus.Committed ? "committed" : "discarded").
            <MudLink Href="/import-csv">Back to imports</MudLink>
        </MudAlert>
    }
    else
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
            @if (_batch.Records > 0 && _batch.Links > 0)
            {
                <MudSelect T="StagedKind?" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Show" Value="_kind" ValueChanged="ShowAsync" Style="max-width: 10rem"
                           ToStringFunc="@(k => k is null ? "All" : k == StagedKind.Record ? "Records" : "Links")">
                    <MudSelectItem T="StagedKind?" Value="@null">All</MudSelectItem>
                    <MudSelectItem T="StagedKind?" Value="@StagedKind.Record">Records</MudSelectItem>
                    <MudSelectItem T="StagedKind?" Value="@StagedKind.Link">Links</MudSelectItem>
                </MudSelect>
            }
            <MudButton OnClick="@(() => SetAllAsync(true))" Variant="Variant.Text">Include all</MudButton>
            <MudButton OnClick="@(() => SetAllAsync(false))" Variant="Variant.Text">Exclude all</MudButton>
            <MudSpacer />
            <MudButton OnClick="DiscardAsync" Variant="Variant.Text" Color="Color.Error">Discard</MudButton>
            <MudButton OnClick="CommitAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_batch.Included == 0 || _busy)">Commit @Count(_batch.Included)</MudButton>
        </MudStack>
    }

    <MudDataGrid @ref="_grid" T="StagedRow" ServerData="LoadAsync" Dense="true" Hover="true" RowsPerPage="50" Filterable="false" SortMode="SortMode.None">
        <Columns>
            <TemplateColumn T="StagedRow" Title="Import" Sortable="false">
                <CellTemplate>
                    <MudCheckBox T="bool" Value="context.Item.Included" ValueChanged="@(v => SetOneAsync(context.Item, v))" Dense="true"
                                 Disabled="@(_batch.Status != ImportStatus.Staged)" aria-label="@($"Import {context.Item.Title}")" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn T="StagedRow" Title="Type" Sortable="false">
                <CellTemplate>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap">
                        <MudChip T="string" Size="Size.Small" Icon="@StyleOf(context.Item.Type).Icon" Style="@ChipStyle(context.Item.Type)" Class="ma-0">@context.Item.Type</MudChip>
                        @if (context.Item.TargetType is { } target)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                            <MudChip T="string" Size="Size.Small" Icon="@StyleOf(target).Icon" Style="@ChipStyle(target)" Class="ma-0">@target</MudChip>
                        }
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Title" Title="Item" Sortable="false" />
            <PropertyColumn Property="x => x.Detail" Title="Details" Sortable="false" />
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body2">Nothing staged.</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudDataGridPager T="StagedRow" PageSizeOptions="@(new[] { 25, 50, 100 })" />
        </PagerContent>
    </MudDataGrid>
}

@code {
    [Parameter] public long BatchId { get; set; }

    private MudDataGrid<StagedRow>? _grid;
    private StagedBatch? _batch;
    private StagedKind? _kind;
    private Dictionary<string, RecordType> _types = [];
    private bool _missing;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        _batch = await Staging.GetAsync(BatchId);
        _missing = _batch is null;
        _types = (await Records.TypesAsync()).ToDictionary(t => t.Name, t => t, StringComparer.Ordinal);
    }

    // The type's icon and colour, as everywhere else in the app.
    private LabelStyle StyleOf(string type) =>
        _types.TryGetValue(type, out var found) ? GraphStyle.For(type, found.Color, found.Icon) : GraphStyle.For(type, null, null);

    private string ChipStyle(string type) => GraphStyle.ChipStyle(StyleOf(type).Color);

    private static string Count(int count) => count.ToString("N0", CultureInfo.InvariantCulture);

    private async Task<GridData<StagedRow>> LoadAsync(GridState<StagedRow> state, CancellationToken cancellationToken)
    {
        var page = await Staging.ReviewAsync(BatchId, _kind, state.Page, state.PageSize, cancellationToken);
        return new GridData<StagedRow> { Items = page.Rows, TotalItems = page.Total };
    }

    private async Task ShowAsync(StagedKind? kind)
    {
        _kind = kind;
        _grid!.NavigateTo(Page.First);
        await _grid.ReloadServerData();
    }

    private async Task SetOneAsync(StagedRow row, bool included)
    {
        await Run(async () => await Staging.SetIncludedAsync(BatchId, [row.Id], included));
        await _grid!.ReloadServerData();
    }

    private async Task SetAllAsync(bool included)
    {
        await Run(async () => await Staging.SetAllIncludedAsync(BatchId, _kind, included));
        await _grid!.ReloadServerData();
    }

    private async Task CommitAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Commit {Count(_batch!.Included)} item(s)?",
            _batch.Updating > 0
                ? "They are added and updated together. Undoing the import afterwards removes what it added and puts back the values it changed."
                : "They are added together. Undoing the import afterwards removes them again.",
            yesText: "Commit", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        try
        {
            var committed = await Staging.CommitAsync(BatchId);
            Snackbar.Add($"Added {Count(committed.Added)}.", Severity.Success);
            // A full load, so the rail lists a type that's new.
            Navigation.NavigateTo("/import-csv", forceLoad: true);
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscardAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Discard this import?", "Nothing is added, and the staged items are dropped.", yesText: "Discard", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        if (await Run(async () => await Staging.DiscardAsync(BatchId)))
        {
            Snackbar.Add("Import discarded.", Severity.Success);
            Navigation.NavigateTo("/import-csv");
        }
    }

    private async Task<bool> Run(Func<Task> action)
    {
        try
        {
            await action();
            _batch = await Staging.GetAsync(BatchId);
            return true;
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            return false;
        }
    }
}
