@page "/explore"
@using FilterOperator = Linkbase.Core.Graph.FilterOperator
@using Linkbase.Core.Views
@implements IAsyncDisposable
@inject GraphRepository Graph
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject Microsoft.Extensions.Logging.ILogger<ExplorePage> Log
@inject Linkbase.Core.Timeline.TimelineRepository Times

<PageTitle>Explore</PageTitle>

<div class="explore">
    <div class="explore-top">
        @if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_loadError</MudAlert>
        }

        <PatternSearchBar @ref="_searchBar" Schema="_schema" OnRun="RunPatternAsync" OnShowModel="ShowModelAsync" AutoFocus="true" />
        <AskBox @ref="_askBox" Schema="_schema" OnAnswer="RunAnswerAsync" />

        @if (_lastPattern is not null && _patternRemaining > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Showing the first @_patternShown matches. @_patternRemaining more.
                <MudButton OnClick="ShowMorePatternAsync" Variant="Variant.Text" Size="Size.Small">Show more</MudButton>
            </MudAlert>
        }

        @if (_summaryOpen && _summary is not null)
        {
            <div class="explore-summary mt-2" role="region" aria-label="Totals of the search">
                @if (_summary.Count == 0)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">The types in this search have no number fields to total.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0">
                        <thead>
                            <tr><th>Type</th><th>Field</th><th class="text-right">Count</th><th class="text-right">Sum</th><th class="text-right">Min</th><th class="text-right">Max</th><th class="text-right">Average</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _summary)
                            {
                                <tr>
                                    <td>@row.Label</td>
                                    <td>@GraphStyle.PropertyTitle(row.Key)</td>
                                    <td class="text-right">@Figure(row.Count)</td>
                                    <td class="text-right">@Figure(row.Sum)</td>
                                    <td class="text-right">@Figure(row.Min)</td>
                                    <td class="text-right">@Figure(row.Max)</td>
                                    <td class="text-right">@Figure(row.Average)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">Over every match of the search, not only those shown. A node counts once however often it matches.</MudText>
                }
            </div>
        }
    </div>

    <div class="explore-stage">
        @* Always rendered, because Cytoscape attaches to this element once. *@
        @* Where Esc in the search box goes (see hotkeys.js), so the keyboard is on the graph and its shortcuts work. *@
        <div @ref="_canvas" class="explore-canvas" tabindex="-1" aria-label="Graph" aria-busy="@(Busy ? "true" : "false")" data-hotkey-home></div>

        @if (Busy)
        {
            @* Fades in after a short delay (see app.css), so quick loads don't flash it. *@
            <MudProgressLinear Indeterminate="true" Size="Size.Small" Color="Color.Primary" Class="explore-busy" role="progressbar" aria-label="Loading" />
        }

        @if (_nodes.Count > 0)
        {
            <div class="explore-tools">
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false">
                    <MudButton OnClick="@(() => ShowViewAsync(false))" Variant="@(_table ? Variant.Outlined : Variant.Filled)" Color="@(_table ? Color.Default : Color.Primary)"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Hub" title="Graph (t)" aria-pressed="@(_table ? "false" : "true")">Graph</MudButton>
                    <MudButton OnClick="@(() => ShowViewAsync(true))" Variant="@(_table ? Variant.Filled : Variant.Outlined)" Color="@(_table ? Color.Primary : Color.Default)"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.TableRows" title="Table (t)" aria-pressed="@(_table ? "true" : "false")">Table</MudButton>
                </MudButtonGroup>
                @if (_lastPattern is not null)
                {
                    <MudButton OnClick="ToggleSummaryAsync" Variant="@(_summaryOpen ? Variant.Filled : Variant.Outlined)" Color="@(_summaryOpen ? Color.Primary : Color.Default)"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Functions" title="Totals of number fields (s)" aria-pressed="@(_summaryOpen ? "true" : "false")">Totals</MudButton>
                }
                <MudMenu Label="Export" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Size="Size.Small" Dense="true"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ChildContent>
                        <MudMenuItem OnClick="ExportNodesAsync" Icon="@Icons.Material.Outlined.TableView">Nodes (CSV)</MudMenuItem>
                        <MudMenuItem OnClick="ExportLinksAsync" Icon="@Icons.Material.Outlined.Share">Links (CSV)</MudMenuItem>
                        <MudMenuItem OnClick="ExportJsonAsync" Icon="@Icons.Material.Outlined.DataObject">Nodes and links (JSON)</MudMenuItem>
                        <MudMenuItem OnClick="ExportPictureAsync" Icon="@Icons.Material.Outlined.Image">Picture of the graph (PNG)</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </div>
        }

        @if (_table && _nodes.Count > 0)
        {
            <div class="explore-table-wrap">
                <ExploreTable Nodes="VisibleNodes.ToList()" Edges="_edges" Schema="_schema" SelectedId="@_selected?.Id" OnSelect="SelectFromTableAsync" />
            </div>
        }

        @if (_nodes.Count == 0)
        {
            <div class="explore-empty">Type anything above and press Enter, or start with a type. Type graph to see the model. Right-click a node to expand it. Press ? for keyboard shortcuts.</div>
        }

        @if (_menu is { } menu)
        {
            <div class="explore-menu" style="@($"left: {menu.X:0}px; top: {menu.Y:0}px")">
                <MudText Typo="Typo.caption" Class="px-3 py-1 d-block">@menu.Node.Name</MudText>
                <MudDivider Class="my-1" />
                <MudButton OnClick="@(() => ExpandFromMenuAsync(null))" Variant="Variant.Text" Size="Size.Small" FullWidth="true">Expand all (@menu.Counts.Sum(c => c.Count))</MudButton>
                @foreach (var count in menu.Counts)
                {
                    <MudButton OnClick="@(() => ExpandFromMenuAsync(count.RelType))" Variant="Variant.Text" Size="Size.Small" FullWidth="true">
                        @PatternBuilder.RelText(count.RelType, count.Outgoing) @count.OtherLabel (@count.Count)
                    </MudButton>
                }
                <MudDivider Class="my-1" />
                <MudButton OnClick="@(() => RemoveFromMenuAsync(menu.Node.Id))" Variant="Variant.Text" Size="Size.Small" FullWidth="true">Remove</MudButton>
                <MudButton OnClick="@(() => RemoveOthersAsync(menu.Node.Id))" Variant="Variant.Text" Size="Size.Small" FullWidth="true">Remove others</MudButton>
                @if (GraphStyle.Link(menu.Node) is { } menuLink)
                {
                    <MudButton Href="@menuLink" Variant="Variant.Text" Size="Size.Small" FullWidth="true">Open and edit</MudButton>
                }
            </div>
        }
    </div>

    <aside class="explore-panel">
        @if (_selected is { } node)
        {
            <MudChip T="string" Size="Size.Small" Style="@GraphStyle.ChipStyle(GraphStyle.For(node, _schema).Color)" Class="ma-0 mb-1">@node.Label</MudChip>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@ShownName(node)</MudText>

            @if (ShownProperties(node).Count > 0)
            {
                <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                    <tbody>
                        @foreach (var section in PropertySection.Of(node.Label, ShownProperties(node), _schema))
                        {
                            @if (section.Group is not null)
                            {
                                <tr><th colspan="2" scope="colgroup" class="group-heading">@section.Group</th></tr>
                            }

                            @foreach (var property in section.Properties)
                            {
                                <tr><td class="@(section.Group is null ? "" : "in-group")" style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">@GraphStyle.PropertyTitle(property.Key)</td><td>@property.Value</td></tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (node.IsModel)
            {
                <MudButton OnClick="@(() => ShowTypeAsync(node.Label))" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mb-1">Show all @node.Label nodes</MudButton>
            }
            else if (_remaining.GetValueOrDefault(node.Id) is > 0 and var remaining)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">@remaining more linked here weren't added.</MudAlert>
                <MudButton OnClick="@(() => ExpandAsync(node.Id))" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mb-1">Show more</MudButton>
            }
            else
            {
                <MudButton OnClick="@(() => ExpandAsync(node.Id))" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" Class="mb-1">@(_expanded.Contains(node.Id) ? "Expand again" : "Expand")</MudButton>
            }

            @if (!node.IsModel)
            {
                <MudButton OnClick="FindPathAsync" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" Class="mb-1"
                           title="How is it connected to another record? (w)">Find a path…</MudButton>
                <MudButton OnClick="ShowNearbyChangesAsync" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" Class="mb-1"
                           title="What changed in its neighbourhood since a date (d)">What changed nearby…</MudButton>
                <MudButton OnClick="@(() => RemoveAsync(node.Id))" Variant="Variant.Outlined" Size="Size.Small" FullWidth="true" Class="mb-1"
                           title="Takes it off the graph. Expanding a neighbour brings it back. (Delete)">Remove</MudButton>
            }
            @if (GraphStyle.Link(node) is { } link)
            {
                <MudButton Href="@link" Variant="Variant.Text" Size="Size.Small" FullWidth="true" EndIcon="@Icons.Material.Filled.OpenInNew" title="Open its page (o), or in a new tab (Ctrl+O)" data-hotkey-open>Open and edit</MudButton>
            }
        }
        else if (_selectedEdge is { } edge)
        {
            <MudChip T="string" Size="Size.Small" Class="ma-0 mb-1">Link</MudChip>
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@edge.RelType</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                <tbody>
                    <tr><td style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">From</td><td><MudLink OnClick="@(() => SelectEndAsync(edge.SourceId))">@EndName(edge.SourceId)</MudLink></td></tr>
                    <tr><td style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">To</td><td><MudLink OnClick="@(() => SelectEndAsync(edge.TargetId))">@EndName(edge.TargetId)</MudLink></td></tr>
                    @if (_showingModel && _modelLinks.TryGetValue(ModelKey(edge), out var modelLink))
                    {
                        <tr><td style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">Links</td><td>@modelLink.Links.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                        <tr><td style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">Attributes</td><td>@(modelLink.Attributes.Count == 0 ? "none" : string.Join(", ", modelLink.Attributes))</td></tr>
                    }
                    @if (edge.Values is { } values)
                    {
                        @foreach (var value in values)
                        {
                            <tr><td style="white-space: nowrap; vertical-align: top; color: var(--mud-palette-text-secondary)">@GraphStyle.PropertyTitle(value.Key)</td><td>@value.Value</td></tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>
            @if (!_showingModel)
            {
                <LinkHistory Edge="edge" />
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary)">Click a node for its details, or a link for its values. Right-click it to expand or remove, or double-click to expand everything linked to it, up to @ExpansionLimit at a time.</MudText>
        }

        <div class="explore-section-title">On the canvas</div>
        <div class="d-flex flex-wrap" style="gap: 4px">
            @foreach (var label in _schema?.Labels ?? [])
            {
                var onCanvas = VisibleNodes.Count(n => n.Label == label && !n.IsModel);
                <MudChip T="string" Size="Size.Small" Style="@ChipStyle(label)" Class="ma-0">@label@(onCanvas > 0 ? $" {onCanvas}" : "")</MudChip>
            }
        </div>
        <MudSwitch T="bool" Value="_linkValues" ValueChanged="ToggleLinkValuesAsync" Label="@(_showingModel ? "Show attribute names on links" : "Show values on links")"
                   Color="Color.Primary" Size="Size.Small" Class="mt-1" />
        @if (!_showingModel && _nodes.Count > 0)
        {
            <div class="explore-section-title">As of</div>
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="Show the graph as it was on" Date="_asOf" DateChanged="ChooseAsOfAsync"
                           Clearable="true" DateFormat="yyyy-MM-dd" MaxDate="DateTime.Today" />
            @if (_historyStart is not null)
            {
                <MudSlider T="int" Min="0" Max="HistoryDays" Value="SliderValue" ValueChanged="SlideAsync" Immediate="false" Size="Size.Small" aria-label="Day to show the graph as of" />
            }
            @if (_asOf is not null)
            {
                var hiddenNodes = _asOfView.MissingNodes.Count;
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">
                    As of @_asOf.Value.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture): @hiddenNodes @(hiddenNodes == 1 ? "record" : "records") and
                    @_asOfView.MissingEdges.Count @(_asOfView.MissingEdges.Count == 1 ? "link" : "links") didn't exist yet, so aren't shown.
                    Values are as they were. Records since deleted can't be shown.
                </MudText>
            }
        }
        <MudStack Row="true" Spacing="1" Class="mt-2">
            <MudButton OnClick="FitAsync" Variant="Variant.Outlined" Size="Size.Small" Style="flex: 1" Disabled="_nodes.Count == 0" title="Fit (f)">Fit</MudButton>
            <MudButton OnClick="ClearAsync" Variant="Variant.Outlined" Size="Size.Small" Style="flex: 1" Disabled="_nodes.Count == 0" title="Clear (c)">Clear</MudButton>
        </MudStack>

        <div class="explore-section-title">Saved views</div>
        <MudStack Row="true" Spacing="1">
            <MudButton OnClick="OpenViewsAsync" Variant="Variant.Outlined" Size="Size.Small" Style="flex: 1" StartIcon="@Icons.Material.Filled.Bookmarks"
                       title="Save this search and canvas under a name, or open one (v)">Views</MudButton>
            <MudButton OnClick="CopyLinkAsync" Variant="Variant.Outlined" Size="Size.Small" Style="flex: 1" StartIcon="@Icons.Material.Filled.Link"
                       Disabled="@(CurrentState().IsEmpty)" title="Copy a link that opens Explore as it is now">Copy link</MudButton>
        </MudStack>

        <div class="explore-section-title">When expanding, only show</div>
        <MudStack Spacing="2">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="Relationships" SelectedValues="_relTypes" SelectedValuesChanged="ChooseRelTypes" MultiSelection="true" Clearable="true">
                @foreach (var relType in _schema?.RelTypes ?? [])
                {
                    <MudSelectItem T="string" Value="relType">@relType</MudSelectItem>
                }
            </MudSelect>
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="string" Label="Property" Value="_filterKey" ValueChanged="ChooseFilterKey" Clearable="true">
                @foreach (var key in (_schema?.Properties ?? []).Where(p => p.Key != "name").Select(p => p.Key).Distinct().Order(StringComparer.Ordinal))
                {
                    <MudSelectItem T="string" Value="key">@key</MudSelectItem>
                }
            </MudSelect>
            @if (_filterKey is not null)
            {
                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="FilterOperator" Label="Is" @bind-Value="_filterOperator" ToStringFunc="@(op => PatternBuilder.OperatorText(op))">
                    @foreach (var op in PatternBuilder.OperatorsFor(FilterKeyType))
                    {
                        <MudSelectItem T="FilterOperator" Value="op">@PatternBuilder.OperatorText(op)</MudSelectItem>
                    }
                </MudSelect>
                @if (FilterKeyType == GraphValueType.Choice)
                {
                    <MudSelect T="string" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_filterValue" Label="Value" ToStringFunc="@(v => v ?? "")">
                        @foreach (var option in _schema!.Properties.First(p => p.Key == _filterKey).Options)
                        {
                            <MudSelectItem Value="@option">@option</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_filterValue" Label="Value" Immediate="true" />
                }
                <MudButton OnClick="AddFilter" Variant="Variant.Outlined" Size="Size.Small" Disabled="@string.IsNullOrWhiteSpace(_filterValue)">Add filter</MudButton>
            }
            @if (_propertyFilters.Count > 0)
            {
                <MudChipSet T="string" AllClosable="true" OnClose="RemoveFilter">
                    @foreach (var filter in _propertyFilters)
                    {
                        <MudChip T="string" Size="Size.Small" Text="@FilterText(filter)" Value="@FilterText(filter)" />
                    }
                </MudChipSet>
            }
        </MudStack>
    </aside>
</div>
