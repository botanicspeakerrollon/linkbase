@using Linkbase.Core.Ask
@implements IDisposable
@inject QuestionService Questions
@inject IConfiguration Configuration

@if (Available)
{
    <div class="ask-box mt-2">
        <div class="pattern-bar" @onclick="FocusAsync">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="color: var(--mud-palette-text-secondary)" />
            <input @ref="_input" @key="_inputKey"
                   @oninput="OnInput"
                   @onkeydown="OnKeyDownAsync"
                   disabled="@_asking"
                   maxlength="@QuestionService.MaxQuestionLength"
                   aria-label="Ask a question"
                   data-hotkey-search
                   autocomplete="off"
                   spellcheck="false"
                   placeholder="@Placeholder" />
            @if (!string.IsNullOrWhiteSpace(_question))
            {
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="Clear" aria-label="Clear question" />
                <MudButton OnClick="AskAsync" Disabled="_asking" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Ask</MudButton>
            }
        </div>
        @if (_asking)
        {
            <MudProgressLinear Indeterminate="true" Size="Size.Small" Class="mt-1" />
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">@_error</MudAlert>
        }
        <div class="ask-note">The answer appears in the search bar above, where you can change it. Your question is sent to an AI model to be read.</div>
    </div>
}

@code {
    [Parameter, EditorRequired] public GraphSchema? Schema { get; set; }
    [Parameter] public EventCallback<GraphPattern> OnAnswer { get; set; }

    private ElementReference _input;
    private string? _question;

    // The box is never given its text to show: over a slow link the server's reply to an earlier key would put it back. Clearing
    // it replaces the element, which then takes focus.
    private int _inputKey;
    private bool _refocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocus)
        {
            _refocus = false;
            await FocusAsync();
        }
    }
    private string? _error;
    private bool _asking;
    private CancellationTokenSource? _cancel;

    // The question goes to the model provider, so an administrator can turn it off with the same setting as reading text.
    public bool Available => Schema is not null
        && !string.Equals(Configuration["Extraction:Enabled"], "false", StringComparison.OrdinalIgnoreCase);

    // An example made from the model's own types, so it reads right for any model.
    private string Placeholder => Example(Schema) is { } example ? $"Ask in plain English, such as: {example}" : "Ask in plain English about your data";

    public static string? Example(GraphSchema? schema)
    {
        if (schema is null)
        {
            return null;
        }

        var number = schema.Properties.FirstOrDefault(p => p.Type == GraphValueType.Number);
        if (number is not null)
        {
            return $"{number.Label} records with {number.Key.Replace('_', ' ')} over 10";
        }

        var link = schema.Connections.FirstOrDefault(c => c.SourceLabel != c.TargetLabel);
        return link is null ? null : $"{link.SourceLabel} records linked to a {link.TargetLabel}";
    }

    public async Task FocusAsync() => await _input.FocusAsync();

    private void OnInput(ChangeEventArgs e) => _question = e.Value?.ToString();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AskAsync();
        }
    }

    private void Clear()
    {
        _question = null;
        _inputKey++;
        _refocus = true;
        _error = null;
    }

    private async Task AskAsync()
    {
        if (_asking || Schema is null)
        {
            return;
        }

        _error = null;
        _asking = true;
        _cancel?.Dispose();
        var cancel = _cancel = new CancellationTokenSource();
        try
        {
            var pattern = await Questions.AskAsync(Schema, _question ?? "", cancel.Token);
            await OnAnswer.InvokeAsync(pattern);
        }
        catch (QuestionFailedException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            // The page closed while the question was out.
        }
        finally
        {
            _asking = false;
        }

        // A disabled input loses focus, so give it back for the next question.
        await FocusAsync();
    }

    public void Dispose()
    {
        _cancel?.Cancel();
        _cancel?.Dispose();
    }
}
