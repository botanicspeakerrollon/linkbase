@* The keyboard shortcuts as a table. They come from the dialog that ? opens, so the two can't disagree. *@
@foreach (var (section, keys) in HotkeysDialog.Sections)
{
    <div class="hotkeys-section">@section</div>
    <MudSimpleTable Dense="true" Elevation="0" Class="mb-3 hotkeys-table">
        <tbody>
            @foreach (var (key, what) in keys)
            {
                <tr>
                    <td class="hotkeys-keys">
                        @foreach (var part in key.Split(' '))
                        {
                            <kbd>@part</kbd>
                        }
                    </td>
                    <td>@what</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}
