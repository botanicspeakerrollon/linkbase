@page "/"
@inject DatabaseStatusService DatabaseStatus
@inject CurrentModel CurrentModel
@inject IGraphRepository Graph
@inject RecordRepository Records
@inject SavedViewRepository SavedViews
@using Linkbase.Core.Views
@inject HomeRepository Overview
@using Linkbase.Core.Home
@using Linkbase.Core.Explore
@using Linkbase.Core.Records

<PageTitle>@CurrentModel.Info.Name</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">@CurrentModel.Info.Name</MudText>
    <MudButton Href="/explore" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Hub">Explore</MudButton>
</MudStack>

@if (_status is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!_status.Connected)
{
    <MudAlert Severity="Severity.Error">Can't reach the database: @_status.Error</MudAlert>
}
else if (_status.PendingMigrations > 0)
{
    <MudAlert Severity="Severity.Warning">
        Connected, but @_status.PendingMigrations migration(s) are pending. Run: dotnet run --project src/Linkbase -- model migrate
    </MudAlert>
}
else if (_counts is not null)
{
    @if (_pinned.Count > 0)
    {
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Pinned views</MudText>
        <div class="d-flex flex-wrap mb-6" style="gap: 8px">
            @foreach (var view in _pinned)
            {
                <MudChip T="string" Href="@view.Href" Variant="Variant.Outlined"
                         Icon="@(view.Kind == SavedViewKind.Explore ? Icons.Material.Filled.Hub : Icons.Material.Filled.TableRows)">@view.Name</MudChip>
            }
        </div>
    }

    @* Every model's home is the same: what's in it, and a way in. *@
    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">What's in this model</MudText>
    @if (_counts.Count == 0)
    {
        <MudText Typo="Typo.body2">Nothing yet. Load a model file with: dotnet run --project src/Linkbase -- model load &lt;file&gt; @CurrentModel.Info.Key</MudText>
    }
    else
    {
        <div class="d-flex flex-wrap" style="gap: 8px">
            @foreach (var (label, count) in _counts.OrderByDescending(c => c.Value))
            {
                var defined = _types.Any(t => t.Name == label);
                <MudChip T="string" Href="@(defined ? GraphStyle.RecordListLink(label) : "/explore")"
                         Style="@GraphStyle.ChipStyle(ColorOf(label))">@label @count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</MudChip>
            }
        </div>

        @if (_links.Count > 0)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">
                Relationships
                <span class="record-count">@_links.Sum(l => l.Links).ToString("N0", System.Globalization.CultureInfo.InvariantCulture) links</span>
            </MudText>
            <MudSimpleTable Dense="true" Elevation="1" Class="home-links">
                <thead>
                    <tr><th>From</th><th>Relationship</th><th>To</th><th class="home-links-count">Links</th></tr>
                </thead>
                <tbody>
                    @foreach (var link in _links)
                    {
                        <tr>
                            <td><span class="home-links-dot" style="@($"background-color: {ColorOf(link.SourceLabel)}")"></span>@link.SourceLabel</td>
                            <td>@link.RelType</td>
                            <td><span class="home-links-dot" style="@($"background-color: {ColorOf(link.TargetLabel)}")"></span>@link.TargetLabel</td>
                            <td class="home-links-count">@link.Links.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (_records.Count > 0)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Recent records</MudText>
            <MudSimpleTable Dense="true" Elevation="1" Class="home-recent">
                <tbody>
                    @foreach (var record in _records)
                    {
                        <tr>
                            <td><span class="home-links-dot" style="@($"background-color: {ColorOf(record.Type)}")"></span>@record.Type</td>
                            <td><MudLink Href="@GraphStyle.RecordLink(record.Type, record.Key)">@record.Name</MudLink></td>
                            <td>@(record.Added ? "Added" : "Edited")</td>
                            <td class="home-when">@When(record.At)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (_changes.Count > 0)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Recent changes</MudText>
            <MudSimpleTable Dense="true" Elevation="1" Class="home-recent">
                <tbody>
                    @foreach (var change in _changes)
                    {
                        <tr>
                            <td class="home-when">@When(change.At)</td>
                            <td>@change.Kind</td>
                            <td>@(string.IsNullOrWhiteSpace(change.Note) ? "No reason given" : change.Note)</td>
                            <td class="home-links-count">@change.Changes.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) changes</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (_imports.Count > 0)
        {
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Recent imports</MudText>
            <MudSimpleTable Dense="true" Elevation="1" Class="home-recent">
                <tbody>
                    @foreach (var import in _imports)
                    {
                        <tr>
                            <td class="home-when">@When(import.At)</td>
                            <td>@import.Source</td>
                            <td>@(import.SourceUrl ?? "")</td>
                            <td>
                                @if (import.Status == ImportStatus.Staged)
                                {
                                    <MudLink Href="@($"/import/review/{import.Id}")">Review</MudLink>
                                }
                                else
                                {
                                    @import.Status
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        @if (_growth is not null && _growth.Any(m => m.Count > 0))
        {
            var most = _growth.Max(m => m.Count);
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-6 mb-2">Records added each month</MudText>
            <div class="home-growth" role="img" aria-label="@GrowthSummary()">
                @foreach (var month in _growth)
                {
                    <div class="home-growth-month" title="@($"{month.Month:MMM yyyy}: {month.Count:N0}")">
                        <div class="home-growth-bar" style="@($"height: {Math.Max(month.Count == 0 ? 0 : 4, (int)(100.0 * month.Count / most))}%")"></div>
                        <span>@month.Month.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture)</span>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private DatabaseStatus? _status;
    private IReadOnlyDictionary<string, int>? _counts;
    private IReadOnlyList<RecordType> _types = [];
    private IReadOnlyList<ConnectionCount> _links = [];
    private IReadOnlyList<SavedViewInfo> _pinned = [];
    private IReadOnlyList<RecentRecord> _records = [];
    private IReadOnlyList<RecentImport> _imports = [];
    private IReadOnlyList<RecentChange> _changes = [];
    private IReadOnlyList<MonthCount>? _growth;

    private const int Shown = 8;

    protected override async Task OnInitializedAsync()
    {
        _status = await DatabaseStatus.GetStatusAsync();
        if (_status is { Connected: true, PendingMigrations: 0 })
        {
            _counts = await Graph.NodeCountsAsync();
            _types = await Records.TypesAsync();
            _links = await Graph.ConnectionCountsAsync();
            _pinned = await SavedViews.PinnedAsync();
            if (CurrentModel.Info.ShowsOnHome(HomeRepository.RecentRecords))
            {
                _records = await Overview.RecentRecordsAsync(Shown);
            }

            if (CurrentModel.Info.ShowsOnHome(HomeRepository.Changes))
            {
                _changes = await Overview.RecentChangesAsync(Shown);
            }

            if (CurrentModel.Info.ShowsOnHome(HomeRepository.Imports))
            {
                _imports = await Overview.RecentImportsAsync(Shown);
            }
        }
    }

    private bool _growthAsked;

    // Growth reads every record, so it comes after the page has drawn, and a failure just leaves the panel out.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_growthAsked && _counts is not null && CurrentModel.Info.ShowsOnHome(HomeRepository.Growth))
        {
            _growthAsked = true;
            try
            {
                _growth = await Overview.GrowthAsync(12, DateTimeOffset.UtcNow);
                StateHasChanged();
            }
            catch (Exception ex) when (ex is Npgsql.NpgsqlException or InvalidOperationException)
            {
                _growth = null;
            }
        }
    }

    private static string When(DateTimeOffset at) => at.ToLocalTime().ToString("d MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private string GrowthSummary() =>
        string.Join(", ", _growth!.Select(m => $"{m.Month:MMM yyyy} {m.Count}"));

    private string ColorOf(string label)
    {
        var defined = _types.FirstOrDefault(t => t.Name == label);
        return GraphStyle.For(label, defined?.Color, defined?.Icon).Color;
    }
}
