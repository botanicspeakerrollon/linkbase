@page "/guide"
@inject CurrentModel CurrentModel

<GuidePage Title="Linkbase guide" Path="/guide" Sections="Contents"
           Lede="Load any connected data, such as people and projects, suppliers, a rail network or a climbing logbook, then explore it as a graph and edit it. There is no query language to learn and no graph database to run.">
    <Hero>
        <div class="d-flex flex-wrap mt-3" style="gap: 8px">
            <MudButton Href="/explore" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Hub">Open Explore</MudButton>
            <MudButton Href="/guide#explore" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PlayCircle">Start with exploring</MudButton>
        </div>

        @* Drawn by hand to show what Explore produces. Its colours stand in for the colours a model gives its types. *@
        <svg class="guide-graph" viewBox="0 0 560 190" role="img" aria-label="A small graph: three people, each working on projects, and the projects needing skills">
            <g class="guide-graph-edges">
                <line x1="90" y1="45" x2="230" y2="45" /><line x1="90" y1="95" x2="230" y2="45" /><line x1="90" y1="95" x2="230" y2="145" />
                <line x1="90" y1="145" x2="230" y2="145" /><line x1="230" y1="45" x2="400" y2="30" /><line x1="230" y1="45" x2="400" y2="95" />
                <line x1="230" y1="145" x2="400" y2="95" /><line x1="230" y1="145" x2="400" y2="160" />
            </g>
            <g class="guide-graph-person"><circle cx="90" cy="45" r="16" /><circle cx="90" cy="95" r="16" /><circle cx="90" cy="145" r="16" /></g>
            <g class="guide-graph-project"><circle cx="230" cy="45" r="20" /><circle cx="230" cy="145" r="20" /></g>
            <g class="guide-graph-skill"><circle cx="400" cy="30" r="13" /><circle cx="400" cy="95" r="13" /><circle cx="400" cy="160" r="13" /></g>
            <g class="guide-graph-labels">
                <text x="90" y="22" text-anchor="middle">Person</text><text x="230" y="20" text-anchor="middle">Project</text>
                <text x="426" y="34">Skill</text><text x="426" y="99">Skill</text><text x="426" y="164">Skill</text>
            </g>
        </svg>
    </Hero>
    <ChildContent>
        <div class="guide-cards">
            <a class="guide-card" href="/guide#explore">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" />
                <strong>Explore without queries</strong>
                <span>Build a search by choosing from suggestions, or just ask in plain English. Then grow the graph one click at a time.</span>
            </a>
            <a class="guide-card" href="/guide#records">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                <strong>Edit what you find</strong>
                <span>Every type gets a list and a record page where you change values and add or remove links, and say why.</span>
            </a>
            <a class="guide-card" href="/guide#import">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" />
                <strong>Import data</strong>
                <span>Bring in CSV files or read text with AI, look through it before anything is written, and undo it later.</span>
            </a>
            <a class="guide-card" href="/guide#history">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                <strong>Nothing is lost</strong>
                <span>Every change is kept with its reason. See what changed, go back to how things were, or put an edit back.</span>
            </a>
            <a class="guide-card" href="/guide#around">
                <MudIcon Icon="@Icons.Material.Filled.Search" Color="Color.Primary" />
                <strong>Jump anywhere</strong>
                <span>Press Ctrl+K to find a record or page, or to start adding one.</span>
            </a>
            <a class="guide-card" href="/guide#keyboard">
                <MudIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" />
                <strong>Keyboard first</strong>
                <span>Search, move around, expand and clear without touching the mouse. Press ? anywhere.</span>
            </a>
        </div>

        @foreach (var domain in CurrentModel.Domains.Where(d => d.GuideHref is not null))
        {
            <MudPaper Class="pa-4 mb-6 d-flex align-center flex-wrap" Elevation="1" Style="gap: 12px">
                <MudIcon Icon="@domain.Icon" Color="Color.Primary" Size="Size.Large" />
                <div style="flex: 1 1 280px">
                    <MudText Typo="Typo.h6" HtmlTag="h2">This model has its own pages: @domain.Name</MudText>
                    <MudText Typo="Typo.body2">The guide below covers what every model can do. The @domain.Name guide covers what it adds.</MudText>
                </div>
                <MudButton Href="@("/" + domain.GuideHref)" Variant="Variant.Outlined">Read the @domain.Name guide</MudButton>
            </MudPaper>
        }

        <GuideSection Id="idea" Title="The idea" Icon="@Icons.Material.Outlined.Lightbulb">
            <p>
                Linkbase keeps your data as <strong>records</strong> and the <strong>links</strong> between them. A record has a type
                (<em>Person</em>, <em>Project</em>, <em>Supplier</em>), a name and some fields. A link joins two records and has a
                relationship, such as <code>WORKS_ON</code>, so the data reads like sentences: <em>this person works on that project</em>.
            </p>
            <p>
                That is a graph, and it answers questions a spreadsheet makes awkward. Which projects need a skill nobody on the team has?
                Who worked with whom? What sits two steps away from this one thing? You ask by clicking, or by typing a question, and never
                by writing a query.
            </p>
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                <thead><tr><th>Word</th><th>Means</th><th>Example</th></tr></thead>
                <tbody>
                    <tr><td>Type</td><td>A kind of record</td><td>Person, Project, Stop</td></tr>
                    <tr><td>Record, or node</td><td>One thing of a type, with a name and fields</td><td>A person called Ada</td></tr>
                    <tr><td>Field</td><td>A value on a record: text, number, date, yes/no, a choice or a list</td><td>joined = 2021-03-01</td></tr>
                    <tr><td>Relationship</td><td>A named way two types can be linked</td><td>WORKS_ON, from Person to Project</td></tr>
                    <tr><td>Link, or edge</td><td>One actual connection between two records. It can carry values of its own</td><td>Ada WORKS_ON Atlas, as Lead, 3 days a week</td></tr>
                    <tr><td>Model</td><td>A complete set of types, records and links, kept apart from other models</td><td>The consultancy, or the rail network</td></tr>
                </tbody>
            </MudSimpleTable>
            <MudAlert Severity="Severity.Info" Dense="true">The Home page lists what is in the current model: how many records of each type, and every relationship with its number of links.</MudAlert>
        </GuideSection>

        <GuideSection Id="around" Title="Getting around" Icon="@Icons.Material.Filled.Navigation">
            <ul class="guide-list">
                <li><strong>The rail</strong> on the left has Home, Explore, a list for each type of record, Import, Timeline, Cleanup and this guide. Hover over it to read the names. When there is more than one model, the name at the top switches between them.</li>
                <li><strong>Quick-find</strong> is <kbd>Ctrl</kbd> <kbd>K</kbd>, from any page, even while typing in a box. Type part of a name to jump to that record, or the name of a page, or <em>Add</em> and a type to start a new record. <kbd>↑</kbd> <kbd>↓</kbd> choose and <kbd>Enter</kbd> goes.</li>
                <li><strong>Every page has an address you can share.</strong> Explore and the record lists keep their state in the address bar, so copying it, or pressing <em>Copy link</em>, opens the same view for anyone who can use this model. Back leaves the page rather than undoing each click.</li>
            </ul>
        </GuideSection>

        <GuideSection Id="explore" Title="Exploring the graph" Icon="@Icons.Material.Filled.Hub">
            <p>Explore is the heart of the app. Open it from the rail, or press <kbd>g</kbd> then <kbd>e</kbd> anywhere.</p>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">1. Start with a search</MudText>
            <p>
                The search box at the top builds a phrase one step at a time, and what it suggests depends on the step you are on.
                Start with a type, then add conditions to it, or follow a relationship to the next type.
            </p>
            <div class="guide-phrase" aria-label="An example search phrase">
                <span class="pattern-node guide-type-a"><span class="pattern-node-label">Person</span><span class="pattern-node-filter">skills contains "postgres"</span></span>
                <span class="pattern-rel">WORKS_ON →</span>
                <span class="pattern-node guide-type-b"><span class="pattern-node-label">Project</span><span class="pattern-node-filter">status = "active"</span></span>
            </div>
            <p class="guide-caption">Read as: people with Postgres among their skills, and the active projects they work on.</p>
            <ul class="guide-list">
                <li>A <strong>type</strong> first, such as Person, or plain text to search every record for a word.</li>
                <li>Then a <strong>property</strong>, how to compare it (<code>=</code>, <code>contains</code>, <code>starts with</code>, <code>&gt;</code> and so on, depending on the field) and a value. Values are suggested from your data.</li>
                <li>Or a <strong>relationship</strong>, written <code>WORKS_ON →</code> when it leaves the record and <code>← WORKS_ON</code> when it arrives. That adds the next step.</li>
                <li>Press <kbd>Enter</kbd> to search. Press <kbd>←</kbd> and <kbd>→</kbd>, or click a step, to add a condition to an earlier step.</li>
                <li>Type <code>graph</code> to see the model itself: every type, and how they are linked. Click a type there, then <em>Show all</em>, to bring in its records.</li>
            </ul>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">Or ask in plain English</MudText>
            <p>
                Unless your administrator has turned it off, the <em>Ask</em> box under the search bar takes a question such as
                <em>people who work on active projects</em> and turns it into a search. It needs the same set-up as Read text. Press <kbd>a</kbd> to jump to it.
            </p>
            <ul class="guide-list">
                <li>The answer appears <strong>in the search bar</strong>, as steps you can read and change, so you see exactly what was searched for and learn how to write it yourself.</li>
                <li>It only ever uses the types, fields and relationships your model really has. If a question does not fit, you are told, and nothing is searched.</li>
                <li>Only your question and the names of the model's types and fields are sent to be read. None of your records or values are.</li>
                <li>Questions such as <em>the most depended-on application component</em> also get a <strong>ranking</strong>: a panel under the graph lists the top few records with how many distinct records each is linked to through the search. Only records with at least one match are counted, and "least" questions are not ranked.</li>
                <li>Press <kbd>Esc</kbd> to leave the box without asking.</li>
            </ul>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">2. Grow the graph from what you find</MudText>
            <ul class="guide-list">
                <li><strong>Click</strong> a node for its details in the panel on the right.</li>
                <li><strong>Right-click</strong> a node to expand it: all its links, or only one relationship. The menu also removes it, removes everything else, or opens its record to edit.</li>
                <li><strong>Double-click</strong> expands everything linked to it. At most 100 are added at a time, and <em>Show more</em> brings in the rest.</li>
                <li><strong>Nodes you already have never move</strong> when others are added, so you keep your bearings. Drag a node and the ones linked near it follow, like a spring.</li>
                <li>Under <em>When expanding, only show</em> in the panel, limit expansion to chosen relationships or to records whose property matches.</li>
                <li>Switch on <em>Show values on links</em> to see what a link carries, such as <code>WORKS_ON · Lead · 3</code>.</li>
            </ul>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">3. Read it as a graph or as a table</MudText>
            <p>
                Press <kbd>t</kbd> to swap the picture for a table of the same nodes. The table is the better way to scan values or sort
                through a lot of records, and selecting a row selects the node, so the two stay in step.
            </p>
            <p>
                Press <kbd>s</kbd> for <em>Totals</em>: the count, sum, smallest, largest and average of the number fields across everything your search found.
            </p>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">4. Keep and share what you built</MudText>
            <ul class="guide-list">
                <li><strong>Saved views</strong> (<kbd>v</kbd>) remember a search, the canvas, the table and the totals under a name, and any list of records with its search and filters. Pin one to put it on Home. Tick <em>Keep nodes exactly where they are</em> when saving to remember their positions too, not just which nodes are on the canvas.</li>
                <li><strong>Export</strong> the canvas as nodes (CSV), links (CSV), nodes and links together (JSON) or a picture (PNG).</li>
            </ul>

            <MudText Typo="Typo.h6" HtmlTag="h3" Class="guide-sub">5. Ask how things connect, and what changed</MudText>
            <ul class="guide-list">
                <li><em>Find a path</em> (<kbd>w</kbd>) asks how the selected record is connected to another. It finds the shortest chain of links, in either direction, and <em>Show on graph</em> draws it. A very busy record can make the search skip part of the graph, and it says so.</li>
                <li><em>What changed nearby</em> (<kbd>d</kbd>) lists the edits made since a date to the record, to the records it is linked to and to their links.</li>
                <li>Click a link and its history appears under its values: when it was made, edited or removed, and why.</li>
                <li><em>As of</em> in the panel hides the records and links that did not exist on a day you choose, and shows the others with the values they had. Drag the slider or pick a date. A record deleted since cannot be shown, and a link added before changes were being kept looks as if it was always there.</li>
            </ul>
        </GuideSection>

        <GuideSection Id="everyday" Title="Home, timeline and cleanup" Icon="@Icons.Material.Outlined.CleaningServices">
            <ul class="guide-list">
                <li><strong>Home</strong> shows your pinned views, what is in the model, what was added or edited lately, the latest changes and imports, and how many records were added each month. A review waiting to be committed has a link there.</li>
                <li><strong>Timeline</strong> lays the records of a type out by one of its dates, newest first, with a bar for each month. Click a month to look closer.</li>
                <li><strong>Cleanup</strong> finds records whose names match apart from capitals and spacing, records with no links, and records missing a required value. Records the app works out for itself, such as trips, are left out.</li>
                <li>To <strong>merge</strong> duplicates, choose the record to keep and press <em>Merge</em>. It keeps its own values, gains any it lacked, and takes over the others' links and ids. The others are deleted, and the history says what went where. If the merged record would break a limit, such as being in two teams, nothing changes and you are told why.</li>
            </ul>
        </GuideSection>

        <GuideSection Id="records" Title="Records and links" Icon="@Icons.Material.Filled.Edit">
            <p>
                Each type in the model gets its own entry in the rail. Its page lists the records, with a search that matches any part of a name
                or a value, filters for its fields, and an <em>Add</em> button for a new one. Click a heading to sort by it.
            </p>
            <ul class="guide-list">
                <li>Open a record to see every field and every link, grouped by relationship. <em>Edit</em> changes the fields. A short note beside a field says what it is for.</li>
                <li><em>Add link</em> joins it to another record. Only relationships the model defines are offered, and some carry values of their own, such as a role, which you fill in as you link.</li>
                <li>A new record can link, or create, the records it needs as it is made: a <em>New</em> button beside a required link opens the same form for that record, and it can do the same in turn. Nothing is saved until you save the outer form.</li>
                <li>Some types are arranged in <strong>levels</strong>, such as countries, regions and areas. A <em>Parent</em> box on the new record form chooses what it is in. It can be left empty for a record at the top level, and is needed below it. You are told if the parent is the wrong level, if the record is already in something, or if a link would go round in a circle. To move a record, remove its link to the old parent, then add a link to the new one.</li>
                <li>A relationship may limit how many links a record can have, such as one team per person. You are told when a link would go over.</li>
                <li><em>Open and edit</em> in Explore (<kbd>o</kbd> with a node selected, or <kbd>Ctrl</kbd>+<kbd>O</kbd> for a new tab that keeps your graph) jumps straight here from any node.</li>
                <li>Fields marked <em>kept by</em> something are worked out by the app, so there is no box to type in.</li>
            </ul>
            <MudAlert Severity="Severity.Warning" Dense="true">
                A record that still has links cannot be deleted. Remove its links first. Deleting asks you to confirm.
            </MudAlert>
        </GuideSection>

        <GuideSection Id="history" Title="Reasons, history and going back" Icon="@Icons.Material.Filled.History">
            <p>
                The app keeps a record of every change: what changed, when, and why. You never switch it on, and it takes no extra steps beyond one line of explanation.
            </p>
            <ul class="guide-list">
                <li>When you save, delete or link something, you are asked for a <strong>reason</strong>: a line in your own words. You can also say where the information came from, such as a web address. A model can make the reason optional.</li>
                <li>A record's page lists its <strong>history</strong>, newest first: each edit with the old and new value, when it was made and why. A record that came from an import says so at the start.</li>
                <li><strong>Revert</strong> beside an edit puts it back, as an edit of its own with its own entry. It only goes ahead if nothing has changed since: if the value was edited again, the link has gone or the record has moved on, you are told, and nothing happens. It can undo a field edit, a link added, removed or edited, a record you created, and a record you deleted, which returns with its values and the links it needs.</li>
                <li>To go back further, use <em>As of</em> in Explore to see the whole graph on an earlier day, or <em>What changed nearby</em> to see what has happened around one record.</li>
            </ul>
            <MudAlert Severity="Severity.Info" Dense="true">An import, or a change the app made by itself, cannot be reverted from a record page. Undo an import from the Import page.</MudAlert>
        </GuideSection>

        <GuideSection Id="import" Title="Importing data" Icon="@Icons.Material.Filled.UploadFile">
            <p>
                <em>Import</em> in the rail is one page with a tab for each way of bringing data in: <strong>CSV file</strong>,
                <strong>Read text</strong>, and any others your model adds.
            </p>
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-3">CSV file</MudText>
            <p>
                A file is either <strong>records of one type</strong>
                or <strong>links between records already here</strong>, so import the records first.
            </p>
            <ol class="guide-list">
                <li><strong>Choose a file.</strong> You see a preview of its columns and a few sample values, and the app guesses what it is from the column names and your existing types.</li>
                <li><strong>Say what it is.</strong> Pick an existing type or name a new one, then choose the key column that identifies each row, the name column, and which columns become fields. For links, pick the type at each end, the column holding each end's key, and the relationship.</li>
                <li><strong>Check.</strong> You are told how many rows would be added and why any would be skipped, and nothing changes yet. Fix what it points out.</li>
                <li><strong>Import.</strong> Records already here are left as they are, so importing the same file twice is safe.</li>
            </ol>
            <p>
                Tick <em>Update records that are already here</em> to let the file change them instead: a record with the same key takes the file's values
                where they differ. An empty cell never wipes a value. The review lists each change as <code>city: Bern → Zurich</code>.
            </p>
            <p>
                <em>Review first</em> stages the rows instead of writing them. You look through what would be added or changed, untick what you do not
                want, and commit when you are happy, or discard the lot. A review waits for you, so you can come back to it from Recent imports.
            </p>
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-3">New model from CSV files</MudText>
            <p>
                Starting a new model with no description of it? Choose <em>New model</em> in the rail, name it and choose all your files at once. It is a model of its own, so none of your existing models change. Each file becomes a type named from the file
                (<em>clients.csv</em> is <em>Client</em>), a column that holds another file's type, such as <em>client_id</em>, becomes a link, and a file of
                two such columns is links between them. Correct anything it guessed, press <em>Check</em>, then <em>Create the model</em>.
                Each file is an import of its own that you can undo.
            </p>
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-3">Read text</MudText>
            <p>
                Paste text, or fetch a page if the site allows it, and Claude looks for records and links of the types in the current model.
                Only what the text actually says is kept: a name or value that is not in it is dropped and
                listed in the review's notes. Records already here are left as they are but can still be linked to. Everything is staged
                for review first.
            </p>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                The text is sent to an AI model to be read, so it only works once your administrator has set it up, and they can turn it off. Your own records are never sent.
            </MudAlert>
            <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-3">Undoing an import</MudText>
            <p>
                <em>Recent imports</em> lists every import with an <em>Undo</em>. It removes what the import added and puts back what it changed.
                Anything you have edited, linked to or relied on since stays, and is listed, so nothing you did afterwards is lost. Once you have dealt
                with those, undo again.
            </p>
        </GuideSection>

        <GuideSection Id="models" Title="Working with models" Icon="@Icons.Material.Filled.Layers">
            <p>
                A model is one self-contained set of data. When more than one is available, the name at the top of the rail becomes a
                switcher: click it and choose another model. Each is kept apart, so they never mix. What is in each model, and what pages it
                has, depends on the model: the Home page shows the types, and a model with pages of its own has its own guide.
            </p>
            <p>
                To start a new model from your own spreadsheets, use <em>New model</em> in the rail. If you need something more than that, such
                as levels, limits or notes on fields, ask whoever looks after the app to set up the model.
            </p>
        </GuideSection>

        <GuideSection Id="keyboard" Title="Keyboard shortcuts" Icon="@Icons.Material.Filled.Keyboard">
            <p>Everything common can be done from the keyboard. Press <kbd>?</kbd> on any page to see this list in place.</p>
            <ShortcutTable />
        </GuideSection>

        <GuideSection Id="tips" Title="Tips" Icon="@Icons.Material.Outlined.TipsAndUpdates">
            <ul class="guide-list">
                <li>Not sure where to start? Type <code>graph</code> in Explore and click a type, or press <kbd>Ctrl</kbd> <kbd>K</kbd> and type a name.</li>
                <li>Too many nodes? Press <kbd>c</kbd> to clear, or select a node and press <kbd>Delete</kbd> to take just that one off the graph. Expanding a neighbour brings it back.</li>
                <li>The picture too crowded to read? Switch to the table with <kbd>t</kbd>.</li>
                <li>Press <kbd>f</kbd> to fit the whole graph to the screen.</li>
                <li>Found something worth keeping? Save it as a view with <kbd>v</kbd> and pin it to Home.</li>
                <li>Made a mistake? Open the record, find the edit in its history and press Revert.</li>
            </ul>
        </GuideSection>
    </ChildContent>
</GuidePage>

@code {
    private static readonly IReadOnlyList<(string Id, string Title)> Contents =
    [
        ("idea", "The idea"),
        ("around", "Getting around"),
        ("explore", "Exploring the graph"),
        ("everyday", "Home, timeline and cleanup"),
        ("records", "Records and links"),
        ("history", "Reasons, history and going back"),
        ("import", "Importing data"),
        ("models", "Working with models"),
        ("keyboard", "Keyboard shortcuts"),
        ("tips", "Tips"),
    ];

    public static IReadOnlyList<(string Id, string Title)> SectionIds => Contents;
}
