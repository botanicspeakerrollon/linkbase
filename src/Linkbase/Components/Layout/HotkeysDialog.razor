@* The keyboard shortcuts, opened with ?. The keys themselves are handled in wwwroot/js/hotkeys.js and by the pages. *@
<MudDialog>
    <TitleContent>Keyboard shortcuts</TitleContent>
    <DialogContent>
        @foreach (var (section, keys) in Sections)
        {
            <div class="hotkeys-section">@section</div>
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-3 hotkeys-table">
                <tbody>
                    @foreach (var (key, what) in keys)
                    {
                        <tr>
                            <td class="hotkeys-keys">
                                @foreach (var part in key.Split(' '))
                                {
                                    <kbd>@part</kbd>
                                }
                            </td>
                            <td>@what</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary)">Apart from the search box's own keys, shortcuts don't work while you're typing in a field. Press Esc or click away first.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    public static readonly IReadOnlyList<(string Section, IReadOnlyList<(string Key, string What)> Keys)> Sections =
    [
        ("Anywhere",
        [
            ("Ctrl K", "Quick-find: jump to a record or page, or add a record. Works in a field too"),
            ("/", "Search, or the first field on the page"),
            ("g h", "Go home"),
            ("g e", "Go to Explore"),
            ("g 1…9", "Go to that item in the menu on the left"),
            ("?", "Show these shortcuts"),
        ]),
        ("Explore search box, with nothing typed",
        [
            ("← →", "Move between the steps, to add a filter to an earlier one"),
            ("Backspace", "Take off the last condition of the chosen step"),
            ("Enter", "Search"),
            ("Esc", "Close the suggestions, then leave the box for the graph's keys"),
        ]),
        ("Explore",
        [
            ("t", "Switch between the graph and the table"),
            ("s", "Show or hide the totals of the search's number fields"),
            ("v", "Save this view, or open a saved one"),
            ("a", "Ask a question in plain English"),
            ("f", "Fit the graph to the screen"),
            ("c", "Clear the graph"),
            ("n p", "Select the next or previous node"),
            ("e", "Expand the selected node"),
            ("w", "Find how the selected node is connected to another record"),
            ("d", "See what changed near the selected node since a date"),
            ("o", "Open the selected node's page, to view and edit it"),
            ("Ctrl O", "The same, in a new tab, so the graph stays"),
            ("Delete", "Remove the selected node. Expanding a neighbour brings it back"),
            ("Esc", "Close the menu, or clear the selection"),
        ]),
        ("Cleanup",
        [
            ("d u m", "Duplicates, records with no links, records missing a required value"),
            ("r", "Look again"),
        ]),
        ("Model",
        [
            ("t", "Types"),
            ("r", "Relationships"),
        ]),
    ];

    private void Close() => Dialog.Close();
}
