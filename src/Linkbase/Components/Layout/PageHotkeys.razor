@implements IAsyncDisposable
@inject IJSRuntime JS

@* Registers the keys a page handles while it is open (see wwwroot/js/hotkeys.js) and passes each one on. Shortcuts are a
   convenience, so a page works without them if the script can't load. *@
@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Keys { get; set; } = [];
    [Parameter] public EventCallback<string> OnKey { get; set; }

    private DotNetObjectReference<PageHotkeys>? _self;
    private IJSObjectReference? _module;
    private int _handle;

    [JSInvokable]
    public Task OnHotkey(string key) => OnKey.InvokeAsync(key);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hotkeys.js");
            _handle = await _module.InvokeAsync<int>("register", _self, Keys.ToArray());
        }
        catch (JSException)
        {
            _module = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister", _handle);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already gone.
            }
        }

        _self?.Dispose();
    }
}
