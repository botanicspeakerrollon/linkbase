@inject RouteRepository Routes
@inject CragRepository Crags

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_name" Label="Name" Required="true" RequiredError="A route needs a name" />
            <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="CragOption" @bind-Value="_crag" Label="Crag" Required="true" RequiredError="Choose a crag"
                             SearchFunc="SearchCragsAsync" ToStringFunc="@(c => c?.Name)" DebounceInterval="200" ResetValueOnEmptyText="true">
                <ItemTemplate Context="option">
                    @option.Name <MudText Typo="Typo.caption" Inline="true">@option.Place</MudText>
                </ItemTemplate>
            </MudAutocomplete>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_grade" Label="Grade" /></MudItem>
                <MudItem xs="6" sm="4">
                    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="GradeSystem?" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_gradeSystem" Label="Grade system" Clearable="true">
                        @foreach (var value in Enum.GetValues<GradeSystem>())
                        {
                            <MudSelectItem T="GradeSystem?" Value="value">@Labels.Of(value)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Discipline?" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_discipline" Label="Discipline" Clearable="true">
                        @foreach (var value in Enum.GetValues<Discipline>())
                        {
                            <MudSelectItem T="Discipline?" Value="value">@Labels.Of(value)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" T="int?" @bind-Value="_lengthM" Label="Length (m)" Min="0" /></MudItem>
                <MudItem xs="6"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" T="int?" @bind-Value="_pitches" Label="Pitches" Min="0" /></MudItem>
            </MudGrid>
            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_description" Label="Description" Lines="3" HelperText="A short note in your own words" />
        </MudForm>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Instance.Cancel())">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Instance { get; set; } = null!;
    [Parameter] public RouteDetail Route { get; set; } = null!;

    private MudForm? _form;
    private string? _name;
    private CragOption? _crag;
    private string? _grade;
    private GradeSystem? _gradeSystem;
    private Discipline? _discipline;
    private int? _lengthM;
    private int? _pitches;
    private string? _description;
    private string? _error;

    protected override void OnInitialized()
    {
        _name = Route.Name;
        _crag = new CragOption(Route.CragId, Route.CragName, null);
        _grade = Route.Grade;
        _gradeSystem = Route.GradeSystem;
        _discipline = Route.Discipline;
        _lengthM = Route.LengthM;
        _pitches = Route.Pitches;
        _description = Route.Description;
    }

    private async Task<IEnumerable<CragOption>> SearchCragsAsync(string text, CancellationToken cancellationToken) =>
        await Crags.FindCragCandidatesAsync(text, cancellationToken);

    private async Task SaveAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid || _crag is null)
        {
            return;
        }

        try
        {
            await Routes.UpdateAsync(Route.Id, new RouteInput(_name!, _grade, _gradeSystem, _discipline, _lengthM, _pitches, _description, _crag.Id));
            Instance.Close(DialogResult.Ok(true));
        }
        catch (LinkbaseValidationException ex)
        {
            _error = ex.Message;
        }
    }
}
