@page "/browse/crag/{Id:long}"
@inject CragRepository Crags
@inject AreaRepository Areas
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_crag?.Name ?? "Crag")</PageTitle>

@if (_crag is null)
{
    @if (_missing)
    {
        <MudAlert Severity="Severity.Warning">This crag no longer exists.</MudAlert>
    }
}
else
{
    <MudBreadcrumbs Items="_crumbs" Class="pa-0 mb-2" />
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4" HtmlTag="h1">@_crag.Name</MudText>
        <MudStack Row="true">
            <MudButton OnClick="EditAsync" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit">Edit</MudButton>
            <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error">Delete</MudButton>
        </MudStack>
    </MudStack>

    <MudText Typo="Typo.body2" Class="mb-4">
        @string.Join(" · ", Facts())
    </MudText>

    <MudTable Items="_routes" Dense="true" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="RouteSummary" SortBy="r => r.Name" InitialDirection="SortDirection.Ascending">Route</MudTableSortLabel></MudTh>
            <MudTh>Grade</MudTh>
            <MudTh>Discipline</MudTh>
            <MudTh><MudTableSortLabel T="RouteSummary" SortBy="r => r.Ascents">Ascents</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="RouteSummary" SortBy="r => r.LastClimbed ?? DateOnly.MinValue">Last climbed</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Route"><MudLink Href="@($"/browse/route/{context.Id}")">@context.Name</MudLink></MudTd>
            <MudTd DataLabel="Grade">@context.Grade</MudTd>
            <MudTd DataLabel="Discipline">@Labels.Of(context.Discipline)</MudTd>
            <MudTd DataLabel="Ascents">@context.Ascents</MudTd>
            <MudTd DataLabel="Last climbed">@context.LastClimbed?.ToString("yyyy")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public long Id { get; set; }

    private CragDetail? _crag;
    private IReadOnlyList<RouteSummary> _routes = [];
    private List<BreadcrumbItem> _crumbs = [];
    private bool _missing;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _crag = await Crags.GetAsync(Id);
        _missing = _crag is null;
        if (_crag is null)
        {
            return;
        }

        _routes = await Crags.RoutesAsync(Id);
        _crumbs = [new BreadcrumbItem("Browse", "/browse")];
        _crumbs.AddRange((await Areas.PathAsync(_crag.AreaId)).Select(p => new BreadcrumbItem(p.Name, $"/browse/area/{p.Id}")));
    }

    private IEnumerable<string> Facts()
    {
        yield return Labels.Count(_routes.Count, "route");
        yield return Labels.Count(_routes.Sum(r => r.Ascents), "ascent");
        if (_crag!.RockType is { } rock)
        {
            yield return rock;
        }

        if (_crag.Lat is { } lat && _crag.Lon is { } lon)
        {
            yield return $"{lat:0.####}, {lon:0.####}";
        }

        if (_crag.Aliases.Count > 0)
        {
            yield return $"Also known as {string.Join(", ", _crag.Aliases)}";
        }

        if (_crag.Notes is { } notes)
        {
            yield return notes;
        }
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<CragDialog> { { d => d.Crag, _crag } };
        var dialog = await Dialogs.ShowAsync<CragDialog>("Edit crag", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Crag saved.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Delete {_crag!.Name}?", "This can't be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Crags.DeleteAsync(Id);
            Snackbar.Add("Crag deleted.", Severity.Success);
            Navigation.NavigateTo($"/browse/area/{_crag.AreaId}");
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }
}
