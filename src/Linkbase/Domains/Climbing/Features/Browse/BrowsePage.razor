@page "/browse"
@page "/browse/area/{AreaId:long}"
@inject AreaRepository Areas

<PageTitle>@(_contents?.Name ?? "Browse")</PageTitle>

@if (_contents is null)
{
    @if (_missing)
    {
        <MudAlert Severity="Severity.Warning">This area no longer exists.</MudAlert>
    }
}
else
{
    <MudBreadcrumbs Items="_crumbs" Class="pa-0 mb-2" />
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@(_contents.Name ?? "Browse")</MudText>

    @if (_contents.SubAreas.Count > 0)
    {
        <MudTable Items="_contents.SubAreas" Dense="true" Hover="true" Class="mb-4" Elevation="1">
            <HeaderContent>
                <MudTh>@(AreaId is null ? "Country" : "Area")</MudTh>
                <MudTh>Crags</MudTh>
                <MudTh>Ascents</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Area"><MudLink Href="@($"/browse/area/{context.Id}")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="Crags">@context.Crags</MudTd>
                <MudTd DataLabel="Ascents">@context.Ascents</MudTd>
            </RowTemplate>
        </MudTable>
    }

    @if (_contents.Crags.Count > 0)
    {
        <MudTable Items="_contents.Crags" Dense="true" Hover="true" Elevation="1">
            <HeaderContent>
                <MudTh>Crag</MudTh>
                <MudTh>Routes</MudTh>
                <MudTh>Ascents</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Crag"><MudLink Href="@($"/browse/crag/{context.Id}")">@context.Name</MudLink></MudTd>
                <MudTd DataLabel="Routes">@context.Routes</MudTd>
                <MudTd DataLabel="Ascents">@context.Ascents</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public long? AreaId { get; set; }

    private AreaContents? _contents;
    private List<BreadcrumbItem> _crumbs = [];
    private bool _missing;

    protected override async Task OnParametersSetAsync()
    {
        _contents = await Areas.GetContentsAsync(AreaId);
        _missing = _contents is null;
        _crumbs = [new BreadcrumbItem("Browse", "/browse")];
        if (_contents is not null)
        {
            _crumbs.AddRange(_contents.Path.Select(p => new BreadcrumbItem(p.Name, $"/browse/area/{p.Id}")));
        }
    }
}
