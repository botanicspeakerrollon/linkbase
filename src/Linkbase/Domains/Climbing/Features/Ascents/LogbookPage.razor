@page "/logbook"
@inject AscentRepository Ascents
@inject AreaRepository Areas
@inject CragRepository Crags

<PageTitle>Logbook</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Logbook</MudText>
    <MudButton Href="/ascents/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">Add ascent</MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="6" md="2">
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="From" Date="_from" DateChanged="@(d => SetFilterAsync(() => _from = d))" Clearable="true" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" Label="To" Date="_to" DateChanged="@(d => SetFilterAsync(() => _to = d))" Clearable="true" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="AreaOption" Label="Area" Value="_area" ValueChanged="@(a => SetFilterAsync(() => _area = a))"
                             SearchFunc="SearchAreasAsync" ToStringFunc="@(a => a?.Name)" Clearable="true" DebounceInterval="200" ResetValueOnEmptyText="true">
                <ItemTemplate Context="option">
                    @option.Path
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="CragOption" Label="Crag" Value="_crag" ValueChanged="@(c => SetFilterAsync(() => _crag = c))"
                             SearchFunc="SearchCragsAsync" ToStringFunc="@(c => c?.Name)" Clearable="true" DebounceInterval="200" ResetValueOnEmptyText="true">
                <ItemTemplate Context="option">
                    @option.Name <MudText Typo="Typo.caption" Inline="true">@option.Place</MudText>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="GradeSystem?" ToStringFunc="@(v => Labels.Of(v))" Label="Grade system" Value="_gradeSystem" ValueChanged="@(v => SetFilterAsync(() => _gradeSystem = v))" Clearable="true">
                @foreach (var value in Enum.GetValues<GradeSystem>())
                {
                    <MudSelectItem T="GradeSystem?" Value="value">@Labels.Of(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Discipline?" ToStringFunc="@(v => Labels.Of(v))" Label="Discipline" Value="_discipline" ValueChanged="@(v => SetFilterAsync(() => _discipline = v))" Clearable="true">
                @foreach (var value in Enum.GetValues<Discipline>())
                {
                    <MudSelectItem T="Discipline?" Value="value">@Labels.Of(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="AscentStyle?" ToStringFunc="@(v => v is { } style ? Labels.Of(style) : "")" Label="Style" Value="_style" ValueChanged="@(v => SetFilterAsync(() => _style = v))" Clearable="true">
                @foreach (var value in Enum.GetValues<AscentStyle>())
                {
                    <MudSelectItem T="AscentStyle?" Value="value">@Labels.Of(value)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_stats is not null)
{
    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="@($"Summary: {_stats.Total} ascents")">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.h6" HtmlTag="h2">Hardest clean ascent</MudText>
                    <MudText Typo="Typo.caption">Excludes DNF, hangdog, second and top rope.</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var hardest in _stats.Hardest)
                            {
                                <tr>
                                    <td>@Labels.Of(hardest.System)</td>
                                    <td><strong>@hardest.Grade</strong></td>
                                    <td><MudLink Href="@($"/browse/route/{hardest.RouteId}")">@hardest.RouteName</MudLink></td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="6" md="4">
                    <MudText Typo="Typo.h6" HtmlTag="h2">By discipline</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var row in _stats.ByDiscipline)
                            {
                                <tr><td>@(row.Discipline is null ? "None" : Labels.Of(row.Discipline))</td><td>@row.Ascents</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="6" md="4">
                    <MudText Typo="Typo.h6" HtmlTag="h2">By year</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            @foreach (var row in _stats.PerYear)
                            {
                                <tr><td>@row.Year</td><td>@row.Ascents</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

<MudDataGrid @ref="_grid" T="AscentRow" ServerData="LoadAsync" Dense="true" Hover="true" RowsPerPage="50" Filterable="false" SortMode="SortMode.Single">
    <Columns>
        <TemplateColumn Sortable="false">
            <CellTemplate>
                <MudIconButton Href="@($"/ascents/{context.Item.Id}")" Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@($"Edit ascent of {context.Item.RouteName}")" />
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Date" Title="Date" InitialDirection="SortDirection.Descending">
            <CellTemplate>
                <span style="white-space: nowrap">@Labels.Date(context.Item.Date, context.Item.DatePrecision)</span>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.RouteName" Title="Route">
            <CellTemplate>
                <MudLink Href="@($"/browse/route/{context.Item.RouteId}")" Style="white-space: nowrap">@context.Item.RouteName</MudLink>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Grade" Title="Grade" Sortable="false" />
        <PropertyColumn Property="x => x.CragName" Title="Crag">
            <CellTemplate>
                <MudLink Href="@($"/browse/crag/{context.Item.CragId}")" Style="white-space: nowrap">@context.Item.CragName</MudLink>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Style" Title="Style">
            <CellTemplate>
                <span title="@context.Item.StyleRaw">@Labels.Of(context.Item.Style)</span>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Partners" Sortable="false">
            <CellTemplate>@string.Join(", ", context.Item.Partners)</CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.TripName" Title="Trip" Sortable="false">
            <CellTemplate>
                <span style="white-space: nowrap">@context.Item.TripName</span>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Notes" Title="Notes" Sortable="false">
            <CellTemplate>
                <span title="@context.Item.Notes" style="display: block; max-width: 16rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap">@context.Item.Notes</span>
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="AscentRow" PageSizeOptions="@(new[] { 25, 50, 100, 250 })" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<AscentRow>? _grid;
    private AscentStats? _stats;
    private DateTime? _from;
    private DateTime? _to;
    private AreaOption? _area;
    private CragOption? _crag;
    private GradeSystem? _gradeSystem;
    private Discipline? _discipline;
    private AscentStyle? _style;

    private AscentFilter Filter => new()
    {
        From = _from is { } from ? DateOnly.FromDateTime(from) : null,
        To = _to is { } to ? DateOnly.FromDateTime(to) : null,
        AreaId = _area?.Id,
        CragId = _crag?.Id,
        GradeSystem = _gradeSystem,
        Discipline = _discipline,
        Style = _style,
    };

    protected override async Task OnInitializedAsync()
    {
        _stats = await Ascents.StatsAsync(Filter);
    }

    private async Task SetFilterAsync(Action change)
    {
        change();
        _stats = await Ascents.StatsAsync(Filter);
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    private async Task<GridData<AscentRow>> LoadAsync(GridState<AscentRow> state, CancellationToken cancellationToken)
    {
        var sort = state.SortDefinitions.FirstOrDefault();
        var field = sort?.SortBy switch
        {
            nameof(AscentRow.RouteName) => AscentSort.Route,
            nameof(AscentRow.CragName) => AscentSort.Crag,
            nameof(AscentRow.Style) => AscentSort.Style,
            _ => AscentSort.Date,
        };
        var page = await Ascents.SearchAsync(Filter, field, sort?.Descending ?? true, state.Page, state.PageSize, cancellationToken);
        return new GridData<AscentRow> { Items = page.Rows, TotalItems = page.Total };
    }

    private async Task<IEnumerable<AreaOption>> SearchAreasAsync(string text, CancellationToken cancellationToken) =>
        await Areas.SearchAsync(text, cancellationToken);

    private async Task<IEnumerable<CragOption>> SearchCragsAsync(string text, CancellationToken cancellationToken) =>
        await Crags.FindCragCandidatesAsync(text, cancellationToken);
}
