@page "/ascents/new"
@page "/ascents/{Id:long}"
@inject AscentRepository Ascents
@inject AreaRepository Areas
@inject CragRepository Crags
@inject RouteRepository Routes
@inject PartnerRepository Partners
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@(Id is null ? "Add ascent" : "Edit ascent")</PageTitle>

<MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">@(Id is null ? "Add ascent" : "Edit ascent")</MudText>

@if (_notFound)
{
    <MudAlert Severity="Severity.Warning">This ascent no longer exists.</MudAlert>
}
else if (_loaded)
{
    <MudForm @ref="_form">
        <MudStack Spacing="4" Style="max-width: 44rem">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Where</MudText>
                <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="PickOption" Label="Crag" @bind-Value="_crag" @bind-Value:after="OnCragChanged" Required="true" RequiredError="Choose a crag"
                                 SearchFunc="SearchCragsAsync" ToStringFunc="@(o => o?.Name)" DebounceInterval="200" ResetValueOnEmptyText="true" Clearable="true" Class="mb-2">
                    <ItemTemplate Context="option">
                        @option.Label <MudText Typo="Typo.caption" Inline="true">@option.Hint</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_crag is { IsNew: true })
                {
                    <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="PickOption" Label="Area for the new crag" @bind-Value="_newCragArea" Required="true" RequiredError="Choose an area"
                                     SearchFunc="SearchAreasAsync" ToStringFunc="@(o => o?.Name)" DebounceInterval="200" ResetValueOnEmptyText="true" Clearable="true" Class="mb-2">
                        <ItemTemplate Context="option">
                            @option.Label <MudText Typo="Typo.caption" Inline="true">@option.Hint</MudText>
                        </ItemTemplate>
                    </MudAutocomplete>
                }

                <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" T="PickOption" Label="Route" @bind-Value="_route" Required="true" RequiredError="Choose a route" Disabled="_crag is null"
                                 SearchFunc="SearchRoutesAsync" ToStringFunc="@(o => o?.Name)" DebounceInterval="200" ResetValueOnEmptyText="true" Clearable="true"
                                 HelperText="@(_crag is null ? "Choose a crag first" : null)">
                    <ItemTemplate Context="option">
                        @option.Label <MudText Typo="Typo.caption" Inline="true">@option.Hint</MudText>
                    </ItemTemplate>
                </MudAutocomplete>

                @if (_route is { IsNew: true })
                {
                    <MudGrid Spacing="2" Class="mt-2">
                        <MudItem xs="12" sm="4"><MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_grade" Label="Grade" Placeholder="E2 5c" /></MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="GradeSystem?" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_gradeSystem" Label="Grade system" Clearable="true">
                                @foreach (var value in Enum.GetValues<GradeSystem>())
                                {
                                    <MudSelectItem T="GradeSystem?" Value="value">@Labels.Of(value)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="Discipline?" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_discipline" Label="Discipline" Clearable="true">
                                @foreach (var value in Enum.GetValues<Discipline>())
                                {
                                    <MudSelectItem T="Discipline?" Value="value">@Labels.Of(value)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="4"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" T="int?" @bind-Value="_lengthM" Label="Length (m)" Min="0" /></MudItem>
                        <MudItem xs="6" sm="4"><MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" T="int?" @bind-Value="_pitches" Label="Pitches" Min="1" /></MudItem>
                    </MudGrid>
                }
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">How it went</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Date="_date" Label="Date" Required="true" RequiredError="Choose a date" DateFormat="yyyy-MM-dd" />
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="DatePrecision" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_precision" Label="Date is">
                            @foreach (var value in Enum.GetValues<DatePrecision>())
                            {
                                <MudSelectItem T="DatePrecision" Value="value">@Labels.Of(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="4">
                        <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" T="AscentStyle" ToStringFunc="@(v => Labels.Of(v))" @bind-Value="_style" Label="Style" HelperText="@_styleRaw">
                            @foreach (var value in Enum.GetValues<AscentStyle>())
                            {
                                <MudSelectItem T="AscentStyle" Value="value">@Labels.Of(value)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudAutocomplete Variant="Variant.Outlined" Margin="Margin.Dense" @ref="_partnerField" T="string" Label="Add partner" ValueChanged="AddPartner" Class="mt-2"
                                 SearchFunc="SearchPartnersAsync" DebounceInterval="200" ResetValueOnEmptyText="true" CoerceText="false" />
                @if (_partners.Count > 0)
                {
                    <MudChipSet T="string" AllClosable="true" OnClose="RemovePartner" Class="mt-1">
                        @foreach (var name in _partners)
                        {
                            <MudChip T="string" Text="@name" Value="@name" />
                        }
                    </MudChipSet>
                }

                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_notes" Label="Notes" Lines="3" Class="mt-2" />

                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-3">
                    <MudText Typo="Typo.body2">My rating</MudText>
                    <MudRating @bind-SelectedValue="_rating" MaxValue="3" />
                    @if (_rating > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _rating = 0)">Clear</MudButton>
                    }
                </MudStack>
            </MudPaper>

            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudStack Row="true">
                    <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">Save</MudButton>
                    <MudButton Href="/logbook" Variant="Variant.Text">Cancel</MudButton>
                </MudStack>
                @if (Id is not null)
                {
                    <MudButton OnClick="DeleteAsync" Variant="Variant.Text" Color="Color.Error" Disabled="_saving">Delete</MudButton>
                }
            </MudStack>
        </MudStack>
    </MudForm>
}

@code {
    // An existing row (Id set), or a new one the save will create (IsNew).
    private sealed record PickOption(long? Id, string Name, string Label, string? Hint, bool IsNew = false);

    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery] public long? RouteId { get; set; }

    private MudForm? _form;
    private bool _loaded;
    private bool _notFound;
    private bool _saving;

    private PickOption? _crag;
    private PickOption? _newCragArea;
    private PickOption? _route;
    private string? _grade;
    private GradeSystem? _gradeSystem;
    private Discipline? _discipline;
    private int? _lengthM;
    private int? _pitches;

    private DateTime? _date = DateTime.Today;
    private DatePrecision _precision = DatePrecision.Day;
    private AscentStyle _style = AscentStyle.Lead;
    private string? _styleRaw;
    private readonly List<string> _partners = [];
    private MudAutocomplete<string>? _partnerField;
    private string? _notes;
    private int _rating;

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } id)
        {
            var ascent = await Ascents.GetForEditAsync(id);
            if (ascent is null)
            {
                _notFound = true;
                return;
            }

            _crag = new PickOption(ascent.CragId, ascent.CragName, ascent.CragName, null);
            _route = new PickOption(ascent.RouteId, ascent.RouteName, ascent.RouteName, ascent.Grade);
            _date = ascent.Date.ToDateTime(TimeOnly.MinValue);
            _precision = ascent.DatePrecision;
            _style = ascent.Style;
            _styleRaw = ascent.StyleRaw is null ? null : $"Originally: {ascent.StyleRaw}";
            _partners.AddRange(ascent.Partners);
            _notes = ascent.Notes;
            _rating = ascent.MyRating ?? 0;
        }
        else if (RouteId is { } routeId && await Routes.GetAsync(routeId) is { } route)
        {
            _crag = new PickOption(route.CragId, route.CragName, route.CragName, null);
            _route = new PickOption(route.Id, route.Name, route.Name, route.Grade);
        }

        _loaded = true;
    }

    private void OnCragChanged()
    {
        // A route belongs to one crag, so changing crag clears a route from the old one.
        _route = null;
    }

    private async Task<IEnumerable<PickOption>> SearchCragsAsync(string text, CancellationToken cancellationToken)
    {
        var found = await Crags.FindCragCandidatesAsync(text, cancellationToken);
        var options = found.Select(c => new PickOption(c.Id, c.Name, c.Name, c.Place)).ToList();
        return WithCreateOption(options, text, "crag");
    }

    private async Task<IEnumerable<PickOption>> SearchAreasAsync(string text, CancellationToken cancellationToken)
    {
        var found = await Areas.SearchAsync(text, cancellationToken);
        var options = found.Select(a => new PickOption(a.Id, a.Name, a.Name, a.Path == a.Name ? null : a.Path)).ToList();
        return WithCreateOption(options, text, "country");
    }

    private async Task<IEnumerable<PickOption>> SearchRoutesAsync(string text, CancellationToken cancellationToken)
    {
        if (_crag is null)
        {
            return [];
        }

        var options = _crag.Id is { } cragId
            ? (await Routes.SearchAsync(cragId, text, cancellationToken)).Select(r => new PickOption(r.Id, r.Name, r.Name, r.Grade)).ToList()
            : [];
        return WithCreateOption(options, text, "route");
    }

    private static IEnumerable<PickOption> WithCreateOption(List<PickOption> options, string text, string kind)
    {
        var name = text?.Trim();
        if (!string.IsNullOrEmpty(name) && !options.Any(o => string.Equals(o.Name, name, StringComparison.OrdinalIgnoreCase)))
        {
            options.Add(new PickOption(null, name, $"Create new {kind}: {name}", null, IsNew: true));
        }

        return options;
    }

    private async Task<IEnumerable<string>> SearchPartnersAsync(string text, CancellationToken cancellationToken)
    {
        var found = (await Partners.SearchNamesAsync(text, cancellationToken)).Except(_partners).ToList();
        var name = text?.Trim();
        if (!string.IsNullOrEmpty(name) && !found.Contains(name, StringComparer.Ordinal) && !_partners.Contains(name))
        {
            found.Add(name);
        }

        return found;
    }

    private async Task AddPartner(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        if (!_partners.Contains(name))
        {
            _partners.Add(name);
        }

        // Ready for the next name. Clearing raises this handler again with null.
        await _partnerField!.ClearAsync();
    }

    private void RemovePartner(MudChip<string> chip)
    {
        if (chip.Value is { } name)
        {
            _partners.Remove(name);
        }
    }

    private AscentInput BuildInput()
    {
        NewRouteInput? newRoute = null;
        if (_route is { IsNew: true })
        {
            var newCrag = _crag is { IsNew: true }
                ? new NewCragInput(_crag.Name, _newCragArea?.Id, _newCragArea is { IsNew: true } ? _newCragArea.Name : null)
                : null;
            newRoute = new NewRouteInput(_route.Name, _grade, _gradeSystem, _discipline, _lengthM, _pitches, _crag?.Id, newCrag);
        }

        return new AscentInput
        {
            RouteId = _route?.Id,
            NewRoute = newRoute,
            Date = DateOnly.FromDateTime(_date ?? DateTime.Today),
            DatePrecision = _precision,
            Style = _style,
            Partners = _partners,
            Notes = _notes,
            MyRating = _rating > 0 ? (short)_rating : null,
        };
    }

    private async Task SaveAsync()
    {
        if (_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _saving = true;
        try
        {
            if (Id is { } id)
            {
                await Ascents.UpdateAsync(id, BuildInput());
            }
            else
            {
                await Ascents.CreateAsync(BuildInput());
            }

            Snackbar.Add("Ascent saved.", Severity.Success);
            Navigation.NavigateTo("/logbook");
        }
        catch (LinkbaseValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete this ascent?", "This can't be undone.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true && Id is { } id)
        {
            await Ascents.DeleteAsync(id);
            Snackbar.Add("Ascent deleted.", Severity.Success);
            Navigation.NavigateTo("/logbook");
        }
    }
}
